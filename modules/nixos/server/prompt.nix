# The desktops' shell look on servers: the desktops get ii's starship.toml, transient prompt
# and empty fish greeting from illogical-impulse's fish config (~/.config/fish), which servers
# do not have. Same starship.toml, read straight from the pinned dots-hyprland input, so a
# flake update changes both together. ii's colour sequences (generated by quickshell) and its
# desktop-only aliases are left out.
{ inputs, lib, ... }:
{
  programs.starship = {
    settings = lib.importTOML "${inputs.dots-hyprland}/dots/.config/starship.toml";
    # Past prompts collapse to `starship module character`, like ii's enable_transience.
    transientPrompt.enable = true;
  };

  programs.fish.interactiveShellInit = ''
    set fish_greeting
  '';
}
