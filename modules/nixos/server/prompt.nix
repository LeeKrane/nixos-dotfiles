# The desktops' shell look on servers: the desktops get ii's starship.toml, transient prompt
# and empty fish greeting from illogical-impulse's fish config (~/.config/fish), which servers
# do not have. Same starship.toml, read straight from the pinned dots-hyprland input, so a
# flake update changes both together. ii's colour sequences (generated by quickshell) and its
# desktop-only aliases are left out.
#
# One addition: ii's format has no $hostname, and on a server it matters which host the shell
# is on. It goes in front of $directory, always shown (not only over SSH).
{ inputs, lib, ... }:
let
  ii = lib.importTOML "${inputs.dots-hyprland}/dots/.config/starship.toml";
in
{
  # Fails the build if ii's format stops containing $directory, instead of silently dropping
  # the hostname.
  assertions = [
    {
      assertion = lib.hasInfix "$directory" ii.format;
      message = "prompt.nix: ii's starship format no longer contains $directory; update where $hostname goes.";
    }
  ];

  programs.starship = {
    settings = ii // {
      format = lib.replaceStrings [ "$directory" ] [ "$hostname$directory" ] ii.format;
      hostname = {
        ssh_only = false;
        format = "[$hostname]($style) ";
        style = "bold fg:246";
      };
    };
    # Past prompts collapse to `starship module character`, like ii's enable_transience.
    transientPrompt.enable = true;
  };

  programs.fish.interactiveShellInit = ''
    set fish_greeting
  '';
}
