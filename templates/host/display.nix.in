# One catch-all monitor rule; after first login, name the real outputs (`hyprctl monitors -j`).
{ osConfig, ... }:
{
  krane.hypr = {
    monitors = [
      # Empty output matches every monitor.
      {
        output = "";
        mode = "preferred";
        scale = 1;
      }
    ];

    settings.input = {
      kb_layout = osConfig.krane.keyboard.layout;
      kb_variant = osConfig.krane.keyboard.variant;
@TOUCHPAD@
    };

    variables = {
      terminal = "kitty";
      browser = "zen-beta";
      codeEditor = "kitty -1 nvim";
      textEditor = "kitty -1 nvim";
      fileManager = "dolphin";
    };
  };
}
