From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: krane <chris@krane.dev>
Date: Sat, 28 Nov 2026 17:13:02 +0100
Subject: [PATCH] fix(ai): find a model id case-insensitively and keep the real
 id

Backport of pctrade/end4-pC 061b321
https://github.com/pctrade/end4-pC/commit/061b321
Problem: setModel lowercased the requested id, so a model whose id has uppercase letters (local ollama models) was never found.
Port: clean (offset)
Drop when: the pinned setModel matches ids case-insensitively without rewriting the stored id.
---
 dots/.config/quickshell/ii/services/Ai.qml | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/dots/.config/quickshell/ii/services/Ai.qml b/dots/.config/quickshell/ii/services/Ai.qml
index 57036af0..0b80ffff 100644
--- a/dots/.config/quickshell/ii/services/Ai.qml
+++ b/dots/.config/quickshell/ii/services/Ai.qml
@@ -485,8 +485,10 @@ Singleton {
 
     function setModel(modelId, feedback = true, setPersistentState = true) {
         if (!modelId) modelId = ""
-        modelId = modelId.toLowerCase()
-        if (modelList.indexOf(modelId) !== -1) {
+        // Find the real model ID case-insensitively.
+        const matchedModelId = modelList.find(id => id.toLowerCase() === modelId.toLowerCase())
+        if (matchedModelId !== undefined) {
+            modelId = matchedModelId
             const model = models[modelId]
             // See if policy prevents online models
             if (Config.options.policies.ai === 2 && !model.endpoint.includes("localhost")) {
