From: krane <chris@krane.dev>
Date: Sat, 28 Nov 2026 17:25:27 +0100
Subject: [PATCH] lock: restore focus and pointer to the monitor focused at
 lock time

The lock batch focused each monitor in turn and the unlock batch did it again, so the last monitor kept focus and Hyprland moved the pointer there.

Record the focused monitor and the pointer position (hyprctl cursorpos) before locking. Both batches end with a focus on that monitor and a pointer move back.

Drop when the lock no longer focuses monitors to switch workspaces.
---
 .../quickshell/ii/modules/ii/lock/Lock.qml    | 71 +++++++++++++++----
 1 file changed, 56 insertions(+), 15 deletions(-)

diff --git a/dots/.config/quickshell/ii/modules/ii/lock/Lock.qml b/dots/.config/quickshell/ii/modules/ii/lock/Lock.qml
index 713fcd5e..e843338d 100644
--- a/dots/.config/quickshell/ii/modules/ii/lock/Lock.qml
+++ b/dots/.config/quickshell/ii/modules/ii/lock/Lock.qml
@@ -6,6 +6,7 @@ import qs.modules.common.functions
 import qs.modules.common.panels.lock
 import QtQuick
 import Quickshell
+import Quickshell.Io
 import Quickshell.Hyprland
 
 LockScreen {
@@ -13,6 +14,54 @@ LockScreen {
 
     // Monitor name -> workspace id to restore on unlock (set when locking)
     property var savedWorkspaces: ({})
+    property string focusedMonitorAtLock: ""
+    property bool trackFocus: true
+    property var cursorAtLock: null
+
+    Binding {
+        target: root
+        property: "focusedMonitorAtLock"
+        value: Hyprland.focusedMonitor?.name ?? ""
+        when: root.trackFocus
+        restoreMode: Binding.RestoreNone
+    }
+
+    function focusRestoreBatch() {
+        const mon = root.focusedMonitorAtLock
+        if (!Quickshell.screens.some(s => s.name === mon)) return ""
+        let batch = `hyprctl dispatch 'hl.dsp.focus({monitor="${mon}"})';`
+        if (root.cursorAtLock) batch += `hyprctl dispatch 'hl.dsp.cursor.move({x=${root.cursorAtLock.x}, y=${root.cursorAtLock.y}})';`
+        return batch
+    }
+
+    function pushWorkspaces() {
+        var next = {}
+        var batch = "keyword animation workspaces,1,7,menu_decel,slidevert; "
+        for (var i = 0; i < Quickshell.screens.length; ++i) {
+            var mon = Quickshell.screens[i].name
+            var mData = HyprlandData.monitors.find(m => m.name === mon)
+            if (mData?.activeWorkspace == undefined) {
+                return;
+            }
+            var ws = (mData?.activeWorkspace?.id ?? 1)
+            next[mon] = ws
+            batch += `hyprctl dispatch 'hl.dsp.focus({monitor="${mon}"})'; hyprctl dispatch 'hl.dsp.focus({workspace=${2147483647 - ws}})';`
+        }
+        root.savedWorkspaces = next
+        Quickshell.execDetached(["bash", "-c", batch + root.focusRestoreBatch()])
+    }
+
+    Process {
+        id: snapshotProc
+        command: ["hyprctl", "cursorpos", "-j"]
+        stdout: StdioCollector {
+            id: snapshotCollector
+            onStreamFinished: {
+                root.cursorAtLock = JSON.parse(snapshotCollector.text)
+                root.pushWorkspaces()
+            }
+        }
+    }
 
     Timer {
         id: restoreTimer
@@ -27,9 +76,11 @@ LockScreen {
                     batch += `hyprctl dispatch 'hl.dsp.focus({monitor="${monName}"})'; hyprctl dispatch 'hl.dsp.focus({workspace=${wsId}})';`
                 }
             }
+            batch += root.focusRestoreBatch()
             if (batch.length > 0) {
                 Quickshell.execDetached(["bash", "-c", batch])
             }
+            root.trackFocus = true
         }
     }
 
@@ -42,21 +93,11 @@ LockScreen {
         target: GlobalStates
         function onScreenLockedChanged() {
             if (GlobalStates.screenLocked) {
-                // Lock: save workspace per monitor and move all to temp workspace in one batch
-                var next = {}
-                var batch = "keyword animation workspaces,1,7,menu_decel,slidevert; "
-                for (var i = 0; i < Quickshell.screens.length; ++i) {
-                    var mon = Quickshell.screens[i].name
-                    var mData = HyprlandData.monitors.find(m => m.name === mon)
-                    if (mData?.activeWorkspace == undefined) {
-                        return;
-                    }
-                    var ws = (mData?.activeWorkspace?.id ?? 1)
-                    next[mon] = ws
-                    batch += `hyprctl dispatch 'hl.dsp.focus({monitor="${mon}"})'; hyprctl dispatch 'hl.dsp.focus({workspace=${2147483647 - ws}})';`
-                }
-                root.savedWorkspaces = next
-                Quickshell.execDetached(["bash", "-c", batch])
+                restoreTimer.stop()
+                root.trackFocus = false
+                root.cursorAtLock = null
+                root.savedWorkspaces = ({})
+                snapshotProc.running = true
             } else {
                 restoreTimer.start()
             }
