From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: krane <chris@krane.dev>
Date: Sat, 28 Nov 2026 17:25:37 +0100
Subject: [PATCH] lock: pick the prompt screen

GlobalStates.lockPromptScreen holds the name of the screen that shows the lock prompt: lock.mainMonitor if connected, else the monitor focused at lock time, else the first screen. It follows Quickshell.screens, so unplugging the prompt screen while locked moves it. Nothing reads it yet.

Drop when upstream chooses one lock prompt screen.
---
 dots/.config/quickshell/ii/GlobalStates.qml        |  1 +
 .../ii/modules/common/panels/lock/LockScreen.qml   |  2 +-
 .../.config/quickshell/ii/modules/ii/lock/Lock.qml | 14 ++++++++++++++
 3 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/dots/.config/quickshell/ii/GlobalStates.qml b/dots/.config/quickshell/ii/GlobalStates.qml
index 8415ff3e..d30e22a7 100644
--- a/dots/.config/quickshell/ii/GlobalStates.qml
+++ b/dots/.config/quickshell/ii/GlobalStates.qml
@@ -26,6 +26,7 @@ Singleton {
     property bool searchOpen: false
     property bool screenLocked: false
     property bool screenLockContainsCharacters: false
+    property string lockPromptScreen: ""
     property bool screenUnlockFailed: false
     property bool screenTranslatorOpen: false
     property bool sessionOpen: false
diff --git a/dots/.config/quickshell/ii/modules/common/panels/lock/LockScreen.qml b/dots/.config/quickshell/ii/modules/common/panels/lock/LockScreen.qml
index 0569eb77..96c4600c 100644
--- a/dots/.config/quickshell/ii/modules/common/panels/lock/LockScreen.qml
+++ b/dots/.config/quickshell/ii/modules/common/panels/lock/LockScreen.qml
@@ -22,7 +22,7 @@ Scope {
             anchors.fill: parent
             opacity: active ? 1 : 0
             Behavior on opacity {
-                animation: Appearance.animation.elementMoveFast.colorAnimation.createObject(this)
+                animation: Appearance.animation.elementMoveFast.numberAnimation.createObject(this)
             }
             sourceComponent: root.lockSurface
         }
diff --git a/dots/.config/quickshell/ii/modules/ii/lock/Lock.qml b/dots/.config/quickshell/ii/modules/ii/lock/Lock.qml
index de95f7fd..c80c0b50 100644
--- a/dots/.config/quickshell/ii/modules/ii/lock/Lock.qml
+++ b/dots/.config/quickshell/ii/modules/ii/lock/Lock.qml
@@ -26,6 +26,20 @@ LockScreen {
         restoreMode: Binding.RestoreNone
     }
 
+    readonly property string promptScreenName: {
+        const names = Quickshell.screens.map(s => s.name)
+        const main = Config.options.lock.mainMonitor
+        if (main && names.includes(main)) return main
+        return names[0] ?? ""
+    }
+
+    Binding {
+        target: GlobalStates
+        property: "lockPromptScreen"
+        value: root.promptScreenName
+        when: GlobalStates.screenLocked
+    }
+
     function focusRestoreBatch() {
         const mon = root.focusedMonitorAtLock
         if (!Quickshell.screens.some(s => s.name === mon)) return ""
