From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: krane <chris@krane.dev>
Date: Sat, 28 Nov 2026 17:25:53 +0100
Subject: [PATCH] lock: main monitor setting

lock.mainMonitor names the monitor that shows the lock prompt; empty means the focused monitor. Settings, Interface, ...

Drop when upstream has a lock monitor setting.
---
 .../quickshell/ii/modules/common/Config.qml   |  1 +
 .../ii/modules/settings/HyprlandConfig.qml    | 38 +++++++++++++++++++
 .../ii/modules/settings/InterfaceConfig.qml   |  1 +
 3 files changed, 40 insertions(+)

diff --git a/dots/.config/quickshell/ii/modules/common/Config.qml b/dots/.config/quickshell/ii/modules/common/Config.qml
index 0f011f5b..7eecabbb 100644
--- a/dots/.config/quickshell/ii/modules/common/Config.qml
+++ b/dots/.config/quickshell/ii/modules/common/Config.qml
@@ -418,6 +418,7 @@ Singleton {
                     property bool requirePasswordToPower: false
                 }
                 property bool materialShapeChars: true
+                property string mainMonitor: ""
             }
 
             property JsonObject media: JsonObject {
diff --git a/dots/.config/quickshell/ii/modules/settings/HyprlandConfig.qml b/dots/.config/quickshell/ii/modules/settings/HyprlandConfig.qml
index ceb73d29..180b9d77 100644
--- a/dots/.config/quickshell/ii/modules/settings/HyprlandConfig.qml
+++ b/dots/.config/quickshell/ii/modules/settings/HyprlandConfig.qml
@@ -223,6 +223,44 @@ ContentPage {
                             value = Qt.binding(() => monitorConfig.monitors[monitorCanvas.selectedIndex]?.y ?? 0)
                         }
                     }
+
+                    RowLayout {
+                        id: mainRow
+                        readonly property string monitorName: monitorConfig.monitors[monitorCanvas.selectedIndex]?.name ?? ""
+                        readonly property string mainName: {
+                            const saved = Config.options.lock.mainMonitor
+                            return Quickshell.screens.some(s => s.name === saved) ? saved : (Quickshell.screens[0]?.name ?? "")
+                        }
+                        readonly property bool isMain: monitorName === mainName
+                        Layout.fillWidth: true
+                        Layout.leftMargin: 8
+                        Layout.rightMargin: 8
+                        spacing: 10
+
+                        OptionalMaterialSymbol {
+                            icon: "lock"
+                            iconSize: Appearance.font.pixelSize.larger
+                        }
+                        StyledText {
+                            Layout.fillWidth: true
+                            text: Translation.tr("Main monitor (lock screen prompt, clock, weather)")
+                            color: Appearance.colors.colOnSecondaryContainer
+                        }
+                        StyledText {
+                            visible: mainRow.isMain
+                            text: Translation.tr("This is the main monitor")
+                            font.pixelSize: Appearance.font.pixelSize.smaller
+                            color: Appearance.colors.colSubtext
+                        }
+                        RippleButtonWithIcon {
+                            visible: !mainRow.isMain
+                            Layout.fillWidth: false
+                            buttonRadius: Appearance.rounding.small
+                            materialIcon: "star"
+                            mainText: Translation.tr("Make main monitor")
+                            onClicked: Config.options.lock.mainMonitor = mainRow.monitorName
+                        }
+                    }
                 }
             }
 
diff --git a/dots/.config/quickshell/ii/modules/settings/InterfaceConfig.qml b/dots/.config/quickshell/ii/modules/settings/InterfaceConfig.qml
index 2c1640dc..c75e3419 100644
--- a/dots/.config/quickshell/ii/modules/settings/InterfaceConfig.qml
+++ b/dots/.config/quickshell/ii/modules/settings/InterfaceConfig.qml
@@ -1,5 +1,6 @@
 import QtQuick
 import QtQuick.Layouts
+import Quickshell
 import qs
 import qs.services
 import qs.modules.common
