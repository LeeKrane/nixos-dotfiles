From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: krane <chris@krane.dev>
Date: Fri, 2 Oct 2026 12:00:00 +0200
Subject: [PATCH] fix(settings): gate every section on a pending revert and
 harden the Hyprland page's write paths

Problem: only Displays disabled while a try was pending, so another section
could overwrite the tried monitor rule; Hyprland-page spin boxes wrote on
every drag tick; a hung `hyprctl getoption` left controls silently inert;
the luminance/SDR monitor fields ignored Nix ownership; the revert banner
counted down its own 15 s instead of the real timer.
Fix: revertPending gates every section; spin boxes use onValueModified;
HyprlandConfigOption gets a 5 s watchdog (`available`); every monitor field
control checks monitorLocked; the banner reads state.revertDeadline.
Drop when: the Hyprland page is dropped.
---
 .../models/hyprland/HyprlandConfigOption.qml  |  14 ++
 .../ii/modules/settings/HyprlandConfig.qml    | 154 ++++++++++--------
 2 files changed, 96 insertions(+), 72 deletions(-)

diff --git a/dots/.config/quickshell/ii/modules/common/models/hyprland/HyprlandConfigOption.qml b/dots/.config/quickshell/ii/modules/common/models/hyprland/HyprlandConfigOption.qml
index 241e57f4..20d656a4 100644
--- a/dots/.config/quickshell/ii/modules/common/models/hyprland/HyprlandConfigOption.qml
+++ b/dots/.config/quickshell/ii/modules/common/models/hyprland/HyprlandConfigOption.qml
@@ -14,6 +14,7 @@ NestableObject {
     // True after the first getoption response (even "no such option" or a parse
     // failure). `set` stays false for options left at their default, so it can't gate writes.
     property bool loaded: false
+    property bool available: true
     property var value
     readonly property bool locked: KraneSettings.isLocked("hyprland", root.key)
     readonly property string lockedReason: KraneSettings.nixReason
@@ -31,8 +32,20 @@ NestableObject {
     }
 
     function fetch() {
+        root.available = true;
         fetchProc.command = fetchProc.baseCommand.concat([root.key]);
         fetchProc.running = true;
+        watchdog.restart();
+    }
+
+    Timer {
+        id: watchdog
+        interval: 5000
+        onTriggered: {
+            fetchProc.running = false;
+            root.loaded = true;
+            root.available = false;
+        }
     }
 
     function setValue(newValue) {
@@ -48,6 +61,7 @@ NestableObject {
