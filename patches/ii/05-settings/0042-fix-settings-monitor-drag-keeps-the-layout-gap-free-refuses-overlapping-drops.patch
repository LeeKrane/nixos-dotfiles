diff --git a/dots/.config/quickshell/ii/modules/common/widgets/monitor-layout.js b/dots/.config/quickshell/ii/modules/common/widgets/monitor-layout.js
new file mode 100644
index 00000000..68f18bff
--- /dev/null
+++ b/dots/.config/quickshell/ii/modules/common/widgets/monitor-layout.js
@@ -0,0 +1,134 @@
+.pragma library
+
+// Monitor layout for the Displays canvas. Rects are {x, y, w, h} in logical pixels.
+
+function overlaps(a, b) {
+    return a.x < b.x + b.w && a.x + a.w > b.x && a.y < b.y + b.h && a.y + a.h > b.y
+}
+
+function touches(a, b) {
+    const xo = Math.min(a.x + a.w, b.x + b.w) - Math.max(a.x, b.x)
+    const yo = Math.min(a.y + a.h, b.y + b.h) - Math.max(a.y, b.y)
+    return (xo === 0 && yo > 0) || (yo === 0 && xo > 0)
+}
+
+// Groups of rect indices joined by shared edges.
+function components(rects) {
+    const seen = new Set()
+    const groups = []
+    for (let i = 0; i < rects.length; i++) {
+        if (seen.has(i)) continue
+        const group = [i]
+        seen.add(i)
+        for (let k = 0; k < group.length; k++) {
+            for (let j = 0; j < rects.length; j++) {
+                if (!seen.has(j) && touches(rects[group[k]], rects[j])) {
+                    seen.add(j)
+                    group.push(j)
+                }
+            }
+        }
+        groups.push(group)
+    }
+    return groups
+}
+
+function clamp(v, lo, hi) {
+    return Math.max(lo, Math.min(hi, v))
+}
+
+// Shift {dx, dy} nearest to no shift that puts the group flush against a side of an
+// anchor, sharing at least a quarter of the shorter edge so the cursor can cross, with
+// no group rect overlapping an obstacle. Group edges within thresh of an obstacle edge
+// line up with it. Null when nothing fits.
+function attach(anchors, group, obstacles, thresh) {
+    let alignX = 0, alignY = 0, bestX = thresh, bestY = thresh
+    const dxs = [], dys = []
+    for (const r of group) {
+        for (const o of obstacles) {
+            for (const d of [o.x - r.x, o.x + o.w - r.x, o.x - r.x - r.w, o.x + o.w - r.x - r.w])
+                if (Math.abs(d) < bestX) { bestX = Math.abs(d); alignX = d }
+            for (const d of [o.y - r.y, o.y + o.h - r.y, o.y - r.y - r.h, o.y + o.h - r.y - r.h])
+                if (Math.abs(d) < bestY) { bestY = Math.abs(d); alignY = d }
+            // Slide along an edge to just past another monitor instead of into it.
+            dxs.push(o.x - r.w - r.x, o.x + o.w - r.x)
+            dys.push(o.y - r.h - r.y, o.y + o.h - r.y)
+        }
+    }
+    dxs.unshift(alignX)
+    dys.unshift(alignY)
+
+    let best = null, bestDist = Infinity
+    const consider = (dx, dy) => {
+        const dist = dx * dx + dy * dy
+        if (dist >= bestDist) return
+        for (const r of group) {
+            const m = { x: r.x + dx, y: r.y + dy, w: r.w, h: r.h }
+            if (obstacles.some(o => overlaps(m, o))) return
+        }
+        best = { dx, dy }
+        bestDist = dist
+    }
+    for (const r of group) {
+        for (const a of anchors) {
+            const shareX = Math.round(Math.min(r.w, a.w) / 4)
+            const shareY = Math.round(Math.min(r.h, a.h) / 4)
+            for (const dy of dys) {
+                const cdy = clamp(dy, a.y - r.h + shareY - r.y, a.y + a.h - shareY - r.y)
+                consider(a.x - r.w - r.x, cdy)
+                consider(a.x + a.w - r.x, cdy)
+            }
+            for (const dx of dxs) {
+                const cdx = clamp(dx, a.x - r.w + shareX - r.x, a.x + a.w - shareX - r.x)
+                consider(cdx, a.y - r.h - r.y)
+                consider(cdx, a.y + a.h - r.y)
+            }
+        }
+    }
+    return best
+}
+
+// Layout after dropping rects[idx] at (px, py). rects are {x, y, w, h, locked}.
+// Returns {overlap, positions}: overlap is true, and nothing moves, when the drop lands
+// on another monitor by more than thresh. Otherwise the dropped monitor sits flush
+// against its nearest neighbour, and every group left detached is pulled onto it,
+// nearest first. A group holding a locked monitor stays; the other side moves to it.
+function layout(rects, idx, px, py, thresh) {
+    const out = rects.map(r => ({ x: r.x, y: r.y, w: r.w, h: r.h, locked: r.locked }))
+    const result = overlap => ({ overlap, positions: (overlap ? rects : out).map(r => ({ x: r.x, y: r.y })) })
+    const moved = out[idx]
+    moved.x = px
+    moved.y = py
+    const others = out.filter((_, i) => i !== idx)
+    if (others.length === 0) return result(false)
+
+    const inner = { x: px + thresh, y: py + thresh, w: moved.w - 2 * thresh, h: moved.h - 2 * thresh }
+    if (others.some(o => overlaps(inner, o))) return result(true)
+    const shift = attach(others, [moved], others, thresh)
+    if (!shift) return result(true)
+    moved.x += shift.dx
+    moved.y += shift.dy
+
+    for (;;) {
+        const groups = components(out)
+        if (groups.length < 2) break
+        const main = groups.find(g => g.includes(idx))
+        let best = null
+        for (const g of groups) {
+            if (g === main) continue
+            const moving = g.some(i => out[i].locked) ? main : g
+            if (moving.some(i => out[i].locked)) continue
+            const still = moving === g ? main : g
+            const obstacles = out.filter((_, i) => !moving.includes(i))
+            const s = attach(still.map(i => out[i]), moving.map(i => out[i]), obstacles, thresh)
+            if (s && (!best || s.dx * s.dx + s.dy * s.dy < best.dist))
+                best = { moving, dx: s.dx, dy: s.dy, dist: s.dx * s.dx + s.dy * s.dy }
+        }
+        if (!best) break
+        for (const i of best.moving) {
+            out[i].x += best.dx
+            out[i].y += best.dy
+        }
+    }
+    return result(false)
+}
