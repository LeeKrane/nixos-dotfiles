From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: krane <chris@krane.dev>
Date: Thu, 1 Oct 2026 01:56:44 +0200
Subject: [PATCH] feat(settings): custom window border colors that follow the
 palette

Port of pctrade/end4-pC dc2ca2600ee6: services/HyprlandConfig.qml, services/MaterialThemeLoader.qml, modules/common/Appearance.qml (getColorFromName)
https://github.com/pctrade/end4-pC/tree/dc2ca2600ee6d7852bf0ac91361db8e510f90a74
Problem: the Hyprland page's border colors are palette roles and must be re-resolved on every palette change and after every switch, which wipes shellOverrides/main.lua.
Port: hand-ported (WM checks, setIdle and setAnimPreset dropped; scripts run through their venv shebang, not python3 from PATH; re-apply added on configreloaded; getColorFromName ported verbatim into Appearance.qml since this pin lacks it and the brief did not list this file)
Drop when: upstream ii ships border colors from palette roles.
---
 .../ii/modules/common/Appearance.qml          | 16 +++
 .../quickshell/ii/services/HyprlandConfig.qml | 99 +++++++++++++------
 .../ii/services/MaterialThemeLoader.qml       |  2 +
 3 files changed, 86 insertions(+), 31 deletions(-)

diff --git a/dots/.config/quickshell/ii/modules/common/Appearance.qml b/dots/.config/quickshell/ii/modules/common/Appearance.qml
index bedf01eb..6b88688c 100644
--- a/dots/.config/quickshell/ii/modules/common/Appearance.qml
+++ b/dots/.config/quickshell/ii/modules/common/Appearance.qml
@@ -34,6 +34,22 @@ Singleton {
     property real backgroundTransparency: Config?.options.appearance.transparency.enable ? Config?.options.appearance.transparency.automatic ? autoBackgroundTransparency : Config?.options.appearance.transparency.backgroundTransparency : 0
     property real contentTransparency: Config?.options.appearance.transparency.automatic ? autoContentTransparency : Config?.options.appearance.transparency.contentTransparency
 
+    function getColorFromName(name) {
+        switch (name) {
+            case "primary":            return colors.colPrimary
+            case "secondary":          return colors.colSecondary
+            case "tertiary":           return colors.colTertiary
+            case "primaryContainer":   return colors.colPrimaryContainer
+            case "secondaryContainer": return colors.colSecondaryContainer
+            case "tertiaryContainer":  return colors.colTertiaryContainer
+            case "layer0":             return colors.colLayer0
+            case "layer1":             return colors.colLayer1
+            case "layer0Border":       return colors.colLayer0Border
+            case "black":              return "black"
+            default:                   return colors.colPrimaryContainer
+        }
+    }
+
     m3colors: QtObject {
         property bool darkmode: true
         property bool transparent: false
diff --git a/dots/.config/quickshell/ii/services/HyprlandConfig.qml b/dots/.config/quickshell/ii/services/HyprlandConfig.qml
index 0f2f3f2c..45d9378d 100644
--- a/dots/.config/quickshell/ii/services/HyprlandConfig.qml
+++ b/dots/.config/quickshell/ii/services/HyprlandConfig.qml
@@ -9,46 +9,80 @@ import qs.modules.common
 import qs.modules.common.functions
 
 /**
- * Configs Hyprland
+ * Transient overrides in shellOverrides/main.lua; persistent settings go through KraneSettings.
  */
 Singleton {
     id: root
-    
+
     signal reloaded()
 
