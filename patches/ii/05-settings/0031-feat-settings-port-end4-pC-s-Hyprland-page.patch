From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: krane <chris@krane.dev>
Date: Thu, 1 Oct 2026 03:05:15 +0200
Subject: [PATCH] feat(settings): port end4-pC's Hyprland page

Port of pctrade/end4-pC dc2ca2600ee6: modules/ii/settings/pages/HyprlandConfig.qml
https://github.com/pctrade/end4-pC/tree/dc2ca2600ee6d7852bf0ac91361db8e510f90a74
Problem: Hyprland options, idle, presets, border colors and autostart apps in one page.
Port: hand-ported (live values from hyprctl; writes through krane-ii-settings; startup setMany, require-line notice and Displays removed; Displays return with confirm-or-revert in a later commit)
Drop when: upstream ships an equivalent page, or the settings port is abandoned.
---
 .../common/widgets/ColorSelectionArray.qml    |  98 +++
 .../ii/modules/settings/HyprlandConfig.qml    | 597 ++++++++++++++++++
 2 files changed, 695 insertions(+)
 create mode 100644 dots/.config/quickshell/ii/modules/common/widgets/ColorSelectionArray.qml
 create mode 100644 dots/.config/quickshell/ii/modules/settings/HyprlandConfig.qml

diff --git a/dots/.config/quickshell/ii/modules/common/widgets/ColorSelectionArray.qml b/dots/.config/quickshell/ii/modules/common/widgets/ColorSelectionArray.qml
new file mode 100644
index 00000000..0af1c8ce
--- /dev/null
+++ b/dots/.config/quickshell/ii/modules/common/widgets/ColorSelectionArray.qml
@@ -0,0 +1,98 @@
+import QtQuick
+import QtQuick.Layouts
+import qs.modules.common
+import qs.modules.common.widgets
+
+RowLayout {
+    id: root
+    Layout.fillWidth: true
+    Layout.leftMargin: 8
+    Layout.rightMargin: 8
+    spacing: 10
+
+    property string icon: "palette"
+    property string text: "Color"
+    property string currentValue: ""
+    property var options: ["primary", "secondary", "tertiary", "primaryContainer", "secondaryContainer", "tertiaryContainer", "layer1", "layer0"]
+    property bool showLabel: true
+    property real itemSpacing: 10
+    signal selected(string newValue)
+
+    MaterialSymbol {
+        visible: root.showLabel
+        text: root.icon
+        iconSize: Appearance.font.pixelSize.normal + 5
+        color: Appearance.colors.colOnLayer0
+    }
+
+    StyledText {
+        visible: root.showLabel
+        text: root.text
+        color: Appearance.colors.colOnLayer0
+    }
+
+    Item {
+        visible: root.showLabel
+        Layout.fillWidth: true
+    }
+
+    Flow {
+        Layout.fillWidth: !root.showLabel
+        Layout.preferredWidth: root.showLabel ? implicitWidth : -1
+        spacing: root.itemSpacing
+
+        Repeater {
+            model: root.options
+            delegate: Item {
+                id: slot
+                required property string modelData
+                readonly property bool isSelected: root.currentValue === modelData
+
+                implicitWidth: 40
+                implicitHeight: 40
+
+                Rectangle {
+                    id: ring
+                    anchors.centerIn: parent
+                    width: slot.isSelected ? parent.width : parent.width - 8
+                    height: slot.isSelected ? parent.height : parent.height - 8
+                    radius: slot.isSelected ? Appearance.rounding.normal : width / 2
+                    color: "transparent"
+                    border.width: slot.isSelected ? 2 : 0
+                    border.color: Appearance.colors.colOnLayer0
+
+                    Behavior on radius {
+                        animation: Appearance.animation.elementMoveFast.numberAnimation.createObject(this)
+                    }
+                    Behavior on width {
+                        animation: Appearance.animation.elementMoveFast.numberAnimation.createObject(this)
+                    }
+                    Behavior on height {
+                        animation: Appearance.animation.elementMoveFast.numberAnimation.createObject(this)
+                    }
+                }
+
+                Rectangle {
+                    id: swatch
+                    anchors.centerIn: parent
+                    width: slot.isSelected ? parent.width - 8 : parent.width - 8
+                    height: slot.isSelected ? parent.height - 8 : parent.height - 8
+                    radius: slot.isSelected ? Appearance.rounding.normal - 4 : width / 2 
+                    color: slot.modelData === "black"
+                        ? "black"
+                        : Appearance.colors["col" + slot.modelData.charAt(0).toUpperCase() + slot.modelData.slice(1)]
+
+                    Behavior on radius {
+                        animation: Appearance.animation.elementMoveFast.numberAnimation.createObject(this)
+                    }
+                }
+
+                MouseArea {
+                    anchors.fill: parent
+                    cursorShape: Qt.PointingHandCursor
+                    onClicked: root.selected(slot.modelData)
+                }
+            }
+        }
+    }
+}
\ No newline at end of file
diff --git a/dots/.config/quickshell/ii/modules/settings/HyprlandConfig.qml b/dots/.config/quickshell/ii/modules/settings/HyprlandConfig.qml
new file mode 100644
index 00000000..2b42aef8
--- /dev/null
+++ b/dots/.config/quickshell/ii/modules/settings/HyprlandConfig.qml
@@ -0,0 +1,597 @@
+import QtQuick
+import QtQuick.Layouts
+import Quickshell.Io
+import Quickshell
+import qs.modules.common.functions
+import qs.services
+import qs.modules.common
+import qs.modules.common.widgets
+import qs.modules.common.models.hyprland
+
+ContentPage {
+    id: page
+    forceWidth: true
+
+    function goTo(term) {
+        const t = term.toLowerCase().trim()
+
+        function findTarget(rootItem) {
+            for (let i = 0; i < rootItem.children.length; i++) {
+                let child = rootItem.children[i]
+                if (child.title && child.title.toLowerCase().includes(t)) {
+                    return child
+                }
+            }
+            for (let i = 0; i < rootItem.children.length; i++) {
+                let found = findTarget(rootItem.children[i])
+                if (found) return found
+            }
+            return null
+        }
+
+        let target = findTarget(mainLayout)
+        if (target) {
+            let pos = target.mapToItem(mainLayout, 0, 0)
+            page.contentY = Math.max(0, pos.y - 0)
+        }
+    }
+
+    readonly property var borderColorRoles: ["primary", "secondary", "tertiary", "primaryContainer", "secondaryContainer", "tertiaryContainer", "layer0Border"]
+
+    ColumnLayout {
+        id: mainLayout
+        Layout.fillWidth: true
+        Layout.fillHeight: true
+        spacing: 20
+
+        NoticeBox {
+            Layout.fillWidth: true
+            visible: !KraneSettings.available || KraneSettings.lastError !== "" || !!KraneSettings.state.error
+            text: !KraneSettings.available
+                ? Translation.tr("Changes on this page cannot be saved: krane-ii-settings did not answer. Switch, then restart the shell.")
+                : (KraneSettings.state.error || KraneSettings.lastError)
+        }
+
+        NoticeBox {
+            Layout.fillWidth: true
+            visible: KraneSettings.externalChange
+            text: Translation.tr("ii-settings.json changed outside settings")
+            Item { Layout.fillWidth: true }
+            RippleButtonWithIcon {
+                Layout.fillWidth: false
+                buttonRadius: Appearance.rounding.small
+                materialIcon: "sync"
+                mainText: Translation.tr("Apply now")
+                onClicked: KraneSettings.apply()
+            }
+        }
+
+        // Layout
+        ContentSection {
+            icon: "auto_awesome_mosaic"
+            shape: MaterialShape.Shape.Gem
+            title: Translation.tr("Layout")
+
+            GroupedList {
+                ConfigSelectionArray {
+                    HyprlandConfigOption { id: optLayout; key: "general:layout" }
+                    text: Translation.tr("Tiling Layout") + (optLayout.locked ? ` · ${optLayout.lockedReason}` : "")
+                    icon: "responsive_layout"
+                    enabled: !optLayout.locked
+                    currentValue: optLayout.value
+                    onSelected: newValue => optLayout.setValue(newValue)
+                    options: [
+                        { displayName: Translation.tr("Dwindle"),   icon: "browse",             value: "dwindle"   },
+                        { displayName: Translation.tr("Master"),    icon: "auto_awesome_mosaic", value: "master"    },
+                        { displayName: Translation.tr("Scrolling"), icon: "view_carousel",       value: "scrolling" },
+                    ]
+                }
+            }
+        }
+
+        // Input
+        ContentSection {
+            icon: "trackpad_input"
+            shape: MaterialShape.Shape.Pentagon
+            title: Translation.tr("Input")
+
+            ContentSubsection {
+                title: Translation.tr("Keyboard")
+
+                GroupedList {
+                    ConfigTextArea {
+                        HyprlandConfigOption { id: optKbLayout; key: "input:kb_layout" }
+                        id: kbLayoutField
+                        Layout.fillWidth: true
+                        buttonIcon: "keyboard"
+                        text: Translation.tr("Keyboard layout") + (optKbLayout.locked ? ` · ${optKbLayout.lockedReason}` : "")
+                        placeholderText: Translation.tr("e.g., us, es, latam")
+                        enabled: !optKbLayout.locked
+                        value: optKbLayout.value ?? ""
+                        onValueChanged: kbLayoutDebounceTimer.restart()
+
+                        Timer {
+                            id: kbLayoutDebounceTimer
+                            interval: 1000
+                            repeat: false
+                            onTriggered: {
+                                if (optKbLayout.fetching || !optKbLayout.loaded || kbLayoutField.value === (optKbLayout.value ?? "")) return
+                                optKbLayout.setValue(kbLayoutField.value)
+                            }
+                        }
+                    }
+                    ConfigSwitch {
+                        HyprlandConfigOption { id: optNumlock; key: "input:numlock_by_default" }
+                        buttonIcon: "numbers"
+                        text: Translation.tr("Numlock by default") + (optNumlock.locked ? ` · ${optNumlock.lockedReason}` : "")
+                        enabled: !optNumlock.locked
+                        checked: optNumlock.boolean
+                        onCheckedChanged: {
+                            if (optNumlock.fetching || !optNumlock.loaded || checked === optNumlock.boolean) return
+                            optNumlock.setValue(checked)
+                        }
+                    }
+
+                    ConfigSpinBox {
+                        HyprlandConfigOption { id: optRepeatDelay; key: "input:repeat_delay" }
+                        icon: "keyboard_return"
+                        text: Translation.tr("Repeat delay (ms)") + (optRepeatDelay.locked ? ` · ${optRepeatDelay.lockedReason}` : "")
+                        enabled: !optRepeatDelay.locked
+                        value: optRepeatDelay.number
+                        from: 0; to: 2000; stepSize: 10
+                        onValueChanged: {
+                            if (optRepeatDelay.fetching || !optRepeatDelay.loaded || value === optRepeatDelay.number) return
+                            optRepeatDelay.setValue(value)
+                        }
+                    }
+
+                    ConfigSpinBox {
+                        HyprlandConfigOption { id: optRepeatRate; key: "input:repeat_rate" }
+                        icon: "speed"
+                        text: Translation.tr("Repeat rate") + (optRepeatRate.locked ? ` · ${optRepeatRate.lockedReason}` : "")
+                        enabled: !optRepeatRate.locked
+                        value: optRepeatRate.number
+                        from: 0; to: 200; stepSize: 1
+                        onValueChanged: {
+                            if (optRepeatRate.fetching || !optRepeatRate.loaded || value === optRepeatRate.number) return
+                            optRepeatRate.setValue(value)
+                        }
+                    }
+                    ConfigSelectionArray {
+                        HyprlandConfigOption { id: optFollowMouse; key: "input:follow_mouse" }
+                        text: Translation.tr("Follow mouse") + (optFollowMouse.locked ? ` · ${optFollowMouse.lockedReason}` : "")
+                        icon: "mouse"
+                        enabled: !optFollowMouse.locked
+                        currentValue: optFollowMouse.number
+                        onSelected: newValue => optFollowMouse.setValue(newValue)
+                        options: [
+                            { displayName: Translation.tr("Disabled"), icon: "mouse",     value: 0 },
+                            { displayName: Translation.tr("Full"),     icon: "open_with",  value: 1 },
+                            { displayName: Translation.tr("Loose"),    icon: "drag_pan",   value: 2 },
+                            { displayName: Translation.tr("Explicit"), icon: "ads_click",  value: 3 },
+                        ]
+                    }
+                }
+            }
+
+            ContentSubsection {
+                title: Translation.tr("Touchpad")
+                GroupedList {
+                    ConfigSwitch {
+                        HyprlandConfigOption { id: optNaturalScroll; key: "input:touchpad:natural_scroll" }
+                        buttonIcon: "swap_vert"
+                        text: Translation.tr("Natural scroll") + (optNaturalScroll.locked ? ` · ${optNaturalScroll.lockedReason}` : "")
+                        enabled: !optNaturalScroll.locked
+                        checked: optNaturalScroll.boolean
+                        onCheckedChanged: {
+                            if (optNaturalScroll.fetching || !optNaturalScroll.loaded || checked === optNaturalScroll.boolean) return
+                            optNaturalScroll.setValue(checked)
+                        }
+                    }
+
+                    ConfigSwitch {
+                        HyprlandConfigOption { id: optDisableWhileTyping; key: "input:touchpad:disable_while_typing" }
+                        buttonIcon: "keyboard_hide"
+                        text: Translation.tr("Disable while typing") + (optDisableWhileTyping.locked ? ` · ${optDisableWhileTyping.lockedReason}` : "")
+                        enabled: !optDisableWhileTyping.locked
+                        checked: optDisableWhileTyping.boolean
+                        onCheckedChanged: {
+                            if (optDisableWhileTyping.fetching || !optDisableWhileTyping.loaded || checked === optDisableWhileTyping.boolean) return
+                            optDisableWhileTyping.setValue(checked)
+                        }
+                    }
+
+                    ConfigSwitch {
+                        HyprlandConfigOption { id: optClickfinger; key: "input:touchpad:clickfinger_behavior" }
+                        buttonIcon: "touch_app"
+                        text: Translation.tr("Clickfinger behavior") + (optClickfinger.locked ? ` · ${optClickfinger.lockedReason}` : "")
+                        enabled: !optClickfinger.locked
+                        checked: optClickfinger.boolean
+                        onCheckedChanged: {
+                            if (optClickfinger.fetching || !optClickfinger.loaded || checked === optClickfinger.boolean) return
+                            optClickfinger.setValue(checked)
+                        }
+                    }
+
+                    ConfigSpinBox {
+                        HyprlandConfigOption { id: optScrollFactor; key: "input:touchpad:scroll_factor" }
+                        icon: "swipe"
+                        text: Translation.tr("Scroll factor") + (optScrollFactor.locked ? ` · ${optScrollFactor.lockedReason}` : "")
+                        enabled: !optScrollFactor.locked
+                        value: Math.round(optScrollFactor.number * 10)
+                        from: 1; to: 20; stepSize: 1
+                        onValueChanged: {
+                            if (optScrollFactor.fetching || !optScrollFactor.loaded || value === Math.round(optScrollFactor.number * 10)) return
+                            optScrollFactor.setValue(value / 10.0)
+                        }
+                    }
+                }
+            }
+        }
+
+        // Idle
+        ContentSection {
+            id: idleSection
+            icon: "timer"
+            shape: MaterialShape.Shape.Cookie12Sided
+            title: Translation.tr("Idle")
+
+            readonly property list<var> unitOptions: [
+                { displayName: Translation.tr("Seconds"), icon: "timer",    value: 1    },
+                { displayName: Translation.tr("Minutes"), icon: "av_timer", value: 60   },
+                { displayName: Translation.tr("Hours"),   icon: "schedule", value: 3600 },
+            ]
+
+            component IdleTimerRow: ConfigRow {
+                id: timerRow
+
+                property string icon
+                property string label
+                property int seconds: 0
+                property int displayValue: 60
+                property int displayUnit: 60
+                property bool loaded: false
+
+                signal edited(int newSeconds)
+
+                onSecondsChanged: {
+                    const display = idleSection.toDisplay(timerRow.seconds)
+                    timerRow.displayValue = display[0]
+                    timerRow.displayUnit = display[1]
+                }
+
+                RowLayout {
+                    Layout.fillWidth: true
+                    spacing: 10
+                    Layout.leftMargin: 8
+                    OptionalMaterialSymbol {
+                        icon: timerRow.icon
+                        iconSize: Appearance.font.pixelSize.larger
+                    }
+                    StyledText {
+                        Layout.preferredWidth: 160
+                        text: timerRow.label
+                        color: Appearance.colors.colOnSecondaryContainer
+                        elide: Text.ElideRight
+                    }
+                    Item { Layout.fillWidth: true }
+                    StyledSpinBox {
+                        Layout.preferredWidth: 130
+                        value: timerRow.displayValue
+                        from: 0
+                        to: 9999
+                        stepSize: 1
+                        onValueChanged: {
+                            if (!timerRow.loaded) return
+                            timerRow.displayValue = value
+                            timerRow.edited(value * timerRow.displayUnit)
+                        }
+                    }
+                }
+                StyledComboBox {
+                    Layout.preferredWidth: 140
+                    Layout.alignment: Qt.AlignVCenter
+                    textRole: "displayName"
+                    model: idleSection.unitOptions
+                    currentIndex: idleSection.unitOptions.findIndex(o => o.value === timerRow.displayUnit)
+                    onActivated: index => {
+                        timerRow.displayUnit = idleSection.unitOptions[index].value
+                        timerRow.edited(timerRow.displayValue * timerRow.displayUnit)
+                    }
+                }
+            }
+
+            function toDisplay(seconds) {
+                if (seconds <= 0)
+                    return [0, 60]
+                if (seconds % 3600 === 0)
+                    return [seconds / 3600, 3600]
+                if (seconds % 60 === 0)
+                    return [seconds / 60, 60]
+                return [seconds, 1]
+            }
+
+            NoticeBox {
+                Layout.fillWidth: true
+                visible: KraneSettings.isLocked("idle", "")
+                text: Translation.tr("Idle timeouts are set in Nix: %1. 0 means never.").arg(KraneSettings.nixReason)
+            }
+
+            GroupedList {
+                IdleTimerRow {
+                    icon: "lock_clock"
+                    label: Translation.tr("Lock screen")
+                    enabled: !KraneSettings.isLocked("idle", "")
+                    seconds: KraneSettings.state.idle?.lock ?? 0
+                    // The row's spin box also emits edited() when `seconds` arrives from
+                    // `get` after loading; writing that value back would put ii's default
+                    // into the sparse file on every page open.
+                    onEdited: newSeconds => {
+                        if (KraneSettings.state.idle && newSeconds !== KraneSettings.state.idle.lock)
+                            KraneSettings.set("idle", "lock", newSeconds)
+                    }
+                    Component.onCompleted: loaded = true
+                }
+                IdleTimerRow {
+                    icon: "monitor"
+                    label: Translation.tr("Screen off")
+                    enabled: !KraneSettings.isLocked("idle", "")
+                    seconds: KraneSettings.state.idle?.screenOff ?? 0
+                    onEdited: newSeconds => {
+                        if (KraneSettings.state.idle && newSeconds !== KraneSettings.state.idle.screenOff)
+                            KraneSettings.set("idle", "screenOff", newSeconds)
+                    }
+                    Component.onCompleted: loaded = true
+                }
+                IdleTimerRow {
+                    icon: "bedtime"
+                    label: Translation.tr("Standby")
+                    enabled: !KraneSettings.isLocked("idle", "")
+                    seconds: KraneSettings.state.idle?.suspend ?? 0
+                    onEdited: newSeconds => {
+                        if (KraneSettings.state.idle && newSeconds !== KraneSettings.state.idle.suspend)
+                            KraneSettings.set("idle", "suspend", newSeconds)
+                    }
+                    Component.onCompleted: loaded = true
+                }
+            }
+        }
+
+        // Visual & Aesthetics
+        ContentSection {
+            icon: "deblur"
+            shape: MaterialShape.Shape.PixelCircle
+            title: Translation.tr("Visual & Aesthetics")
+
+            GroupedList {
+                ConfigSpinBox {
+                    HyprlandConfigOption { id: optRounding; key: "decoration:rounding" }
+                    icon: "rounded_corner"
+                    text: Translation.tr("Window Rounding") + (optRounding.locked ? ` · ${optRounding.lockedReason}` : "")
+                    enabled: !optRounding.locked
+                    value: optRounding.number
+                    from: 0; to: 20; stepSize: 1
+                    onValueChanged: {
+                        if (optRounding.fetching || !optRounding.loaded || value === optRounding.number) return
+                        optRounding.setValue(value)
+                    }
+                }
+
+                ConfigSwitch {
+                    HyprlandConfigOption { id: optBlur; key: "decoration:blur:enabled" }
+                    buttonIcon: "blur_on"
+                    text: Translation.tr("Blur") + (optBlur.locked ? ` · ${optBlur.lockedReason}` : "")
+                    enabled: !optBlur.locked
+                    checked: optBlur.boolean
+                    onCheckedChanged: {
+                        if (optBlur.fetching || !optBlur.loaded || checked === optBlur.boolean) return
+                        optBlur.setValue(checked)
+                    }
+                }
+
+                ConfigSpinBox {
+                    HyprlandConfigOption { id: optBlurSize; key: "decoration:blur:size" }
+                    icon: "blur_circular"
+                    text: Translation.tr("Blur Size") + (optBlurSize.locked ? ` · ${optBlurSize.lockedReason}` : "")
+                    enabled: !optBlurSize.locked
+                    value: optBlurSize.number
+                    from: 0; to: 100; stepSize: 1
+                    onValueChanged: {
+                        if (optBlurSize.fetching || !optBlurSize.loaded || value === optBlurSize.number) return
+                        optBlurSize.setValue(value)
+                    }
+                }
+
+                ConfigSpinBox {
+                    HyprlandConfigOption { id: optBlurPasses; key: "decoration:blur:passes" }
+                    icon: "layers"
+                    text: Translation.tr("Blur Passes") + (optBlurPasses.locked ? ` · ${optBlurPasses.lockedReason}` : "")
+                    enabled: !optBlurPasses.locked
+                    value: optBlurPasses.number
+                    from: 0; to: 10; stepSize: 1
+                    onValueChanged: {
+                        if (optBlurPasses.fetching || !optBlurPasses.loaded || value === optBlurPasses.number) return
+                        optBlurPasses.setValue(value)
+                    }
+                }
+
+                ConfigSpinBox {
+                    HyprlandConfigOption { id: optGapsIn; key: "general:gaps_in" }
+                    icon: "margin"
+                    text: Translation.tr("Gaps In") + (optGapsIn.locked ? ` · ${optGapsIn.lockedReason}` : "")
+                    enabled: !optGapsIn.locked
+                    value: optGapsIn.number
+                    from: 0; to: 100; stepSize: 1
+                    onValueChanged: {
+                        if (optGapsIn.fetching || !optGapsIn.loaded || value === optGapsIn.number) return
+                        optGapsIn.setValue(value)
+                    }
+                }
+
+                ConfigSpinBox {
+                    HyprlandConfigOption { id: optGapsOut; key: "general:gaps_out" }
+                    icon: "open_in_full"
+                    text: Translation.tr("Gaps Out") + (optGapsOut.locked ? ` · ${optGapsOut.lockedReason}` : "")
+                    enabled: !optGapsOut.locked
+                    value: optGapsOut.number
+                    from: 0; to: 200; stepSize: 1
+                    onValueChanged: {
+                        if (optGapsOut.fetching || !optGapsOut.loaded || value === optGapsOut.number) return
+                        optGapsOut.setValue(value)
+                    }
+                }
+
+                ConfigSpinBox {
+                    HyprlandConfigOption { id: optActiveOpacity; key: "decoration:active_opacity" }
+                    icon: "opacity"
+                    text: Translation.tr("Active Opacity") + (optActiveOpacity.locked ? ` · ${optActiveOpacity.lockedReason}` : "")
+                    enabled: !optActiveOpacity.locked
+                    value: Math.round(optActiveOpacity.number * 100)
+                    from: 10; to: 100; stepSize: 5
+                    onValueChanged: {
+                        if (optActiveOpacity.fetching || !optActiveOpacity.loaded || value === Math.round(optActiveOpacity.number * 100)) return
+                        optActiveOpacity.setValue(value / 100)
+                    }
+                }
+
+                ConfigSpinBox {
+                    HyprlandConfigOption { id: optInactiveOpacity; key: "decoration:inactive_opacity" }
+                    icon: "opacity"
+                    text: Translation.tr("Inactive Opacity") + (optInactiveOpacity.locked ? ` · ${optInactiveOpacity.lockedReason}` : "")
+                    enabled: !optInactiveOpacity.locked
+                    value: Math.round(optInactiveOpacity.number * 100)
+                    from: 10; to: 100; stepSize: 5
+                    onValueChanged: {
+                        if (optInactiveOpacity.fetching || !optInactiveOpacity.loaded || value === Math.round(optInactiveOpacity.number * 100)) return
+                        optInactiveOpacity.setValue(value / 100)
+                    }
+                }
+                ConfigSpinBox {
+                    HyprlandConfigOption { id: optBorderSize; key: "general:border_size" }
+                    icon: "border_outer"
+                    text: Translation.tr("Border Size") + (optBorderSize.locked ? ` · ${optBorderSize.lockedReason}` : "")
+                    enabled: !optBorderSize.locked
+                    value: optBorderSize.number
+                    from: 0; to: 20; stepSize: 1
+                    onValueChanged: {
+                        if (optBorderSize.fetching || !optBorderSize.loaded || value === optBorderSize.number) return
+                        optBorderSize.setValue(value)
+                    }
+                }
+
+                ConfigSwitch {
+                    buttonIcon: "format_paint"
+                    text: Translation.tr("Custom border colors")
+                    checked: Config.options.hyprland.general.borderColor.enable
+                    onCheckedChanged: {
+                        if (checked === Config.options.hyprland.general.borderColor.enable) return
+                        Config.options.hyprland.general.borderColor.enable = checked
+                        if (checked) HyprlandConfig.applyBorderColors()
+                        else HyprlandConfig.resetBorderColors()
+                    }
+                }
+            }
+
+
+            ContentSubsection {
+                Layout.topMargin: 10
+                visible: Config.options.hyprland.general.borderColor.enable
+                title: Translation.tr("Border Color Management")
+                GroupedList {
+                    visible: Config.options.hyprland.general.borderColor.enable
+
+                    ColorSelectionArray {
+                        icon: "border_color"
+                        text: Translation.tr("Active border")
+                        options: page.borderColorRoles
