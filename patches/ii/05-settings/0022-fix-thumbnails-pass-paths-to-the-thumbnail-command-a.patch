From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: krane <chris@krane.dev>
Date: Wed, 30 Sep 2026 23:13:14 +0200
Subject: [PATCH] fix(thumbnails): pass paths to the thumbnail command as
 arguments

Port of pctrade/end4-pC dc2ca2600ee6: none (krane-only)
https://github.com/pctrade/end4-pC/tree/dc2ca2600ee6d7852bf0ac91361db8e510f90a74
Problem: ThumbnailImage spliced file paths into a bash -c string, so a path with a quote ran commands.
Port: krane-only
Drop when: the pinned ThumbnailImage.qml passes paths to its command safely.
---
 .../quickshell/ii/modules/common/widgets/ThumbnailImage.qml    | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/dots/.config/quickshell/ii/modules/common/widgets/ThumbnailImage.qml b/dots/.config/quickshell/ii/modules/common/widgets/ThumbnailImage.qml
index d3a72e30..a376c32b 100644
--- a/dots/.config/quickshell/ii/modules/common/widgets/ThumbnailImage.qml
+++ b/dots/.config/quickshell/ii/modules/common/widgets/ThumbnailImage.qml
@@ -45,7 +45,8 @@ StyledImage {
             const thumbPath = FileUtils.trimFileProtocol(root.thumbnailPath);
             return ["bash", "-c",
                 // Temp file + mv: concurrent runs or a mid-generation close cannot leave a half-written thumbnail.
-                `[ -f '${thumbPath}' ] && exit 0 || { tmp='${thumbPath}.$$.tmp.png'; magick '${root.sourcePath}' -resize ${maxSize}x${maxSize} "$tmp" && mv "$tmp" '${thumbPath}' && exit 1; exit 2; }`
+                `[ -f "$2" ] && exit 0 || { tmp="$2.$$.tmp.png"; magick "$1" -resize ${maxSize}x${maxSize} "$tmp" && mv "$tmp" "$2" && exit 1; exit 2; }`,
+                "_", root.sourcePath, thumbPath
             ]
         }
         onExited: (exitCode, exitStatus) => {
