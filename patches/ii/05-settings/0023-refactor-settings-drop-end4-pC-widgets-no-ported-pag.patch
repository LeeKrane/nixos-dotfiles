-        text: root.text
-        color: Appearance.colors.colOnLayer0
-    }
-
-    Item {
-        visible: root.showLabel
-        Layout.fillWidth: true
-    }
-
-    Flow {
-        Layout.fillWidth: !root.showLabel
-        Layout.preferredWidth: root.showLabel ? implicitWidth : -1
