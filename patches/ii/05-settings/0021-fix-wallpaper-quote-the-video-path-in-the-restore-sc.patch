From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: krane <chris@krane.dev>
Date: Wed, 30 Sep 2026 22:45:59 +0200
Subject: [PATCH] fix(wallpaper): quote the video path in the restore script

Port of pctrade/end4-pC dc2ca2600ee6: none (krane-only)
https://github.com/pctrade/end4-pC/tree/dc2ca2600ee6d7852bf0ac91361db8e510f90a74
Problem: switchwall.sh wrote the video wallpaper path unescaped into
a script Hyprland runs at every start, so a path with a quote ran
commands.
Port: krane-only
Drop when: the pinned switchwall.sh escapes the path it writes into
the restore script.
---
 dots/.config/quickshell/ii/scripts/colors/switchwall.sh | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/dots/.config/quickshell/ii/scripts/colors/switchwall.sh b/dots/.config/quickshell/ii/scripts/colors/switchwall.sh
index 7c52083a..0233e631 100755
--- a/dots/.config/quickshell/ii/scripts/colors/switchwall.sh
+++ b/dots/.config/quickshell/ii/scripts/colors/switchwall.sh
@@ -117,6 +117,11 @@ kill_existing_mpvpaper() {
 
 create_restore_script() {
     local video_path=$1
+    # $video_path can come from an imported preset's wallpaper path; quote it
+    # with printf '%q' so it is safe to splice into a script Hyprland runs
+    # unattended on every start, even if it contains ", ;, $ etc.
+    local video_path_q
+    video_path_q=$(printf '%q' "$video_path")
     cat > "$RESTORE_SCRIPT.tmp" << EOF
 #!/bin/bash
 # Generated by switchwall.sh - Don't modify it by yourself.
@@ -125,7 +130,7 @@ create_restore_script() {
 pkill -f -9 mpvpaper
 
 for monitor in \$(hyprctl monitors -j | jq -r '.[] | .name'); do
-    mpvpaper -o "$VIDEO_OPTS" "\$monitor" "$video_path" &
+    mpvpaper -o "$VIDEO_OPTS" "\$monitor" $video_path_q &
     sleep 0.1
 done
 EOF
