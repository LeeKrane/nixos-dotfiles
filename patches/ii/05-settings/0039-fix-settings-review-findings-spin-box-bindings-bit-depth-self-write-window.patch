From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: krane <chris@krane.dev>
Date: Fri, 2 Oct 2026 14:00:00 +0200
Subject: [PATCH] fix(settings): review findings: spin box keeps value
 bindings, bit depth capped at 10 and defaults to 8, self-write window opens
 when the command ends, idle spin box capped at 86400 s

---
 .../modules/common/widgets/StyledSpinBox.qml  | 39 +++++++------------
 .../ii/modules/settings/HyprlandConfig.qml    |  8 ++--
 .../quickshell/ii/services/KraneSettings.qml  | 10 +++--
 3 files changed, 24 insertions(+), 33 deletions(-)

diff --git a/dots/.config/quickshell/ii/modules/common/widgets/StyledSpinBox.qml b/dots/.config/quickshell/ii/modules/common/widgets/StyledSpinBox.qml
index 0ae56fa0..76bd5825 100644
--- a/dots/.config/quickshell/ii/modules/common/widgets/StyledSpinBox.qml
+++ b/dots/.config/quickshell/ii/modules/common/widgets/StyledSpinBox.qml
@@ -21,32 +21,21 @@ SpinBox {
         radius: root.radius
     }
 
-    contentItem: Item {
+    // TextInput as contentItem: Qt's commit path applies typed values, so no `root.value = ...` breaks a caller's `value:` binding.
+    contentItem: StyledTextInput {
         implicitHeight: root.baseHeight
-        implicitWidth: Math.max(labelText.implicitWidth, 40)
-
-        StyledTextInput {
-            id: labelText
-            anchors.centerIn: parent
-            text: root.value // displayText would make the numbers weird like 1,000 instead of 1000
-            color: Appearance.colors.colOnLayer2
-            font.family: Appearance.font.family.numbers
-            font.variableAxes: Appearance.font.variableAxes.numbers
-            font.pixelSize: Appearance.font.pixelSize.small
-            validator: root.validator
-            // editingFinished also fires on plain focus-out; compare with the value at focus-in to detect a real edit.
-            property real valueAtFocus: root.value
-            onActiveFocusChanged: {
-                if (activeFocus) valueAtFocus = root.value
-            }
-            onTextChanged: {
-                root.value = parseFloat(text);
-            }
-            // contentItem is not a TextInput, so SpinBox never emits valueModified() for typed input; emit it here, only if the value changed since focus-in.
-            onEditingFinished: {
-                if (root.value !== valueAtFocus) root.valueModified()
-            }
-        }
+        implicitWidth: Math.max(contentWidth, 40)
+        horizontalAlignment: TextInput.AlignHCenter
+        verticalAlignment: TextInput.AlignVCenter
+        text: root.value // not displayText, which formats 1000 as 1,000
+        color: Appearance.colors.colOnLayer2
+        font.family: Appearance.font.family.numbers
+        font.variableAxes: Appearance.font.variableAxes.numbers
+        font.pixelSize: Appearance.font.pixelSize.small
+        validator: root.validator
+        readOnly: !root.editable
+        selectByMouse: true
+        inputMethodHints: root.inputMethodHints
     }
 
     down.indicator: Rectangle {
diff --git a/dots/.config/quickshell/ii/modules/settings/HyprlandConfig.qml b/dots/.config/quickshell/ii/modules/settings/HyprlandConfig.qml
index a2bc47ab..436ad82a 100644
--- a/dots/.config/quickshell/ii/modules/settings/HyprlandConfig.qml
+++ b/dots/.config/quickshell/ii/modules/settings/HyprlandConfig.qml
@@ -235,8 +235,7 @@ ContentPage {
                         text: Translation.tr("Bit depth") + (page.monitorLocked("bitdepth") ? ` · ${KraneSettings.nixReason}` : "")
                         icon: "gradient"
                         enabled: !page.monitorLocked("bitdepth")
-                        currentValue: monitorConfig.monitors[monitorCanvas.selectedIndex]?.bitdepth
-                            ?? (monitorConfig.monitors[monitorCanvas.selectedIndex]?.maxBpc ?? 8)
+                        currentValue: monitorConfig.monitors[monitorCanvas.selectedIndex]?.bitdepth ?? 8
                         onSelected: newValue => {
                             monitorConfig.updateMonitor(monitorCanvas.selectedIndex, { bitdepth: newValue })
                             monitorConfig.save(monitorCanvas.selectedIndex)
@@ -246,7 +245,6 @@ ContentPage {
                             return [
                                 { displayName: "8-bit",  icon: "filter_8", value: 8  },
                                 { displayName: "10-bit", icon: "palette",   value: 10 },
-                                { displayName: "12-bit", icon: "hdr_on",   value: 12 },
                             ].filter(o => o.value <= maxBpc)
                         })()
                     }
@@ -266,7 +264,7 @@ ContentPage {
                         currentValue: monitorConfig.monitors[monitorCanvas.selectedIndex]?.cm ?? "auto"
                         onSelected: newValue => {
                             const hdr = newValue === "hdr" || newValue === "hdredid"
-                            monitorConfig.updateMonitor(monitorCanvas.selectedIndex, hdr ? { cm: newValue, bitdepth: 10 } : { cm: newValue })
+                            monitorConfig.updateMonitor(monitorCanvas.selectedIndex, hdr && !page.monitorLocked("bitdepth") ? { cm: newValue, bitdepth: 10 } : { cm: newValue })
                             monitorConfig.save(monitorCanvas.selectedIndex)
                         }
                     }
@@ -606,7 +604,7 @@ ContentPage {
                         Layout.preferredWidth: 130
                         value: timerRow.displayValue
                         from: 0
-                        to: 9999
+                        to: Math.floor(86400 / timerRow.displayUnit)
                         stepSize: 1
                         onValueModified: {
                             if (!timerRow.loaded) return
diff --git a/dots/.config/quickshell/ii/services/KraneSettings.qml b/dots/.config/quickshell/ii/services/KraneSettings.qml
index 9f648251..e3f497e0 100644
--- a/dots/.config/quickshell/ii/services/KraneSettings.qml
+++ b/dots/.config/quickshell/ii/services/KraneSettings.qml
@@ -85,7 +85,6 @@ Singleton {
             return;
         const args = root._queue[0];
         root._queue = root._queue.slice(1);
-        root._selfWriteUntil = Date.now() + 3000;
         runProc.busy = true;
         runProc.exitedFlag = false;
         runProc.stderrDone = false;
@@ -96,6 +95,7 @@ Singleton {
 
     function _finish(code, errText) {
         runProc.busy = false;
+        root._selfWriteUntil = Date.now() + 3000;
         root.lastError = code === 0 ? "" : (errText.trim() || Translation.tr("krane-ii-settings failed (exit %1)").arg(code));
         root.refresh();
         Qt.callLater(root._next);
@@ -139,7 +139,11 @@ Singleton {
         stdout: StdioCollector {
             onStreamFinished: {
                 try {
-                    root.state = JSON.parse(text);
+                    const next = JSON.parse(text);
+                    // The revert timer's service writes the repo file: not an outside edit.
+                    if (root.state.revertPending === true && next.revertPending !== true)
+                        root._selfWriteUntil = Date.now() + 3000;
+                    root.state = next;
                     root.available = true;
                 } catch (e) {
                     root.available = false;
@@ -159,7 +163,7 @@ Singleton {
         watchChanges: true
         printErrors: false
         onFileChanged: {
-            if (Date.now() > root._selfWriteUntil)
+            if (!runProc.busy && root.state.revertPending !== true && Date.now() > root._selfWriteUntil)
                 root.externalChange = true;
             root.refresh();
         }
