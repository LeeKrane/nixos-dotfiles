+++ b/dots/.config/quickshell/ii/modules/settings/InterfaceConfig.qml
@@ -519,8 +519,8 @@ ContentPage {
                             Config.options.cheatsheet.superKey = newValue;
                         }
                         options: ([
-                          "󰖳", "", "󰨡", "", "󰌽", "󰣇", "", "", "",
-                          "", "", "󱄛", "", "", "", "⌘", "󰀲", "󰟍", ""
