+                          "\u{E77D}", "\u{EF72}", "\u{F111B}", "\u{E7D9}", "\u{F1B6}", "\u{E711}", "\u{2318}", "\u{F0032}", "\u{F07CD}", "\u{F268}"
                         ]).map(icon => { return {
                           displayName: icon,
                           value: icon
