From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: krane <chris@krane.dev>
Date: Thu, 1 Oct 2026 01:50:04 +0200
Subject: [PATCH] feat(settings): declare the Hyprland page's config.json keys

Port of pctrade/end4-pC dc2ca2600ee6: modules/common/Config.qml (hyprland.autostartApps, hyprland.general.borderColor)
https://github.com/pctrade/end4-pC/tree/dc2ca2600ee6d7852bf0ac91361db8e510f90a74
Problem: autostart apps and custom border colors are shell choices kept in config.json.
Port: hand-ported (the rest of the fork's hyprland.* mirror is not ported: Hyprland options live in ii-settings.json)
Drop when: the pinned Config.qml declares hyprland.autostartApps.
---
 .../quickshell/ii/modules/common/Config.qml    | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/dots/.config/quickshell/ii/modules/common/Config.qml b/dots/.config/quickshell/ii/modules/common/Config.qml
index a63bed5d..8ad7c53c 100644
--- a/dots/.config/quickshell/ii/modules/common/Config.qml
+++ b/dots/.config/quickshell/ii/modules/common/Config.qml
@@ -84,6 +84,24 @@ Singleton {
                 property list<string> collapsedSections: []
             }
 
+            // Only choices that stay in config.json; Hyprland options live in hosts/<host>/ii-settings.json.
+            property JsonObject hyprland: JsonObject {
+                property JsonObject autostartApps: JsonObject {
+                    property bool enable: false
+                    property list<var> apps: []
+                }
+                property JsonObject general: JsonObject {
+                    // Off by default so matugen's hyprland/colors.lua keeps applying.
+                    property JsonObject borderColor: JsonObject {
+                        property bool enable: false
+                        property string activeRole: "layer0Border"
+                        property string inactiveRole: "layer0Border"
+                        property real activeOpacity: 0.47
+                        property real inactiveOpacity: 0.2
+                    }
+                }
+            }
+
             property JsonObject profile: JsonObject {
                 property string avatarPath: ""
                 property string avatarPicture: ""
