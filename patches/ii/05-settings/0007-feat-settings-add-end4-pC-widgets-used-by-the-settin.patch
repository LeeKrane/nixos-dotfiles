+    MouseArea {
+        anchors.fill: parent
+        enabled: root.clickAction !== null
+        cursorShape: root.clickAction !== null ? Qt.PointingHandCursor : Qt.ArrowCursor
+        onClicked: {
+            if (root.clickAction) root.clickAction();
+        }
+    }
