index 00000000..fa3e1754
--- /dev/null
+++ b/dots/.config/quickshell/ii/scripts/hyprland/autostart.py
@@ -0,0 +1,50 @@
+#!/usr/bin/env -S\_/bin/sh\_-c\_"source\_\$(eval\_echo\_\$ILLOGICAL_IMPULSE_VIRTUAL_ENV)/bin/activate&&exec\_python\_-E\_"\$0"\_"\$@""
+import json, subprocess, sys, time, os
+
+
+# hyprctl dispatch evaluates cmd as a Lua string literal, so it must be escaped.
+def lua_str(text):
+    escaped = text.replace("\\", "\\\\").replace('"', '\\"')
+    escaped = escaped.replace("\n", "\\n").replace("\t", "\\t").replace("\r", "\\r")
+    return '"' + escaped + '"'
+
+manual = "--manual" in sys.argv[1:]
+
+if not manual:
+    lockfile = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}", "qs-autostart.lock")
+    if os.path.exists(lockfile):
+        exit(0)
+    open(lockfile, 'w').close()
+
+with open(f"{os.environ['HOME']}/.config/illogical-impulse/config.json") as f:
+    data = json.load(f)
+
+autostart = data.get('hyprland', {}).get('autostartApps', {})
+if not autostart.get('enable', False):
+    exit(0)
+
+for app in autostart.get('apps', []):
+    cmd = app.get('cmd', '').strip()
+    if not cmd:
+        continue
+
+    workspace = app.get('workspace', 1)
+    if not isinstance(workspace, int) or isinstance(workspace, bool):
+        print(f"autostart: skipping {cmd!r}, workspace is not an int: {workspace!r}", file=sys.stderr)
+        continue
+
+    delay = app.get('delay', 0)
+    if not isinstance(delay, (int, float)) or isinstance(delay, bool) or delay < 0:
+        delay = 0
+
+    subprocess.run(['hyprctl', 'dispatch', f'hl.dsp.focus({{workspace = {workspace}}})'])
+
+    expanded_cmd = os.path.expanduser(cmd)
+    subprocess.Popen(
+        ['hyprctl', 'dispatch', f'hl.dsp.exec_cmd({lua_str(expanded_cmd)})'],
+        stdout=subprocess.DEVNULL,
+        stderr=subprocess.DEVNULL,
+        close_fds=True
+    )
+
+    time.sleep(delay)
