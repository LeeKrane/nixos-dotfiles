From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: krane <chris@krane.dev>
Date: Thu, 1 Oct 2026 16:15:57 +0200
Subject: [PATCH] feat(settings): displays with confirm-or-revert

Port of pctrade/end4-pC dc2ca2600ee6: modules/ii/settings/pages/HyprlandConfig.qml (Displays)
https://github.com/pctrade/end4-pC/blob/dc2ca2600ee6d7852bf0ac91361db8e510f90a74/modules/ii/settings/pages/HyprlandConfig.qml
Problem: display changes can leave a screen unusable; they must revert on
their own unless confirmed.
Port: hand-ported (Nix-owned fields disabled; HDR only when the EDID
reports it; HDR sets 10-bit; keep-or-revert banner driven by the writer's
timer)
Drop when: the Displays section is dropped.
---
 .../modules/common/widgets/ConfigSpinBox.qml  |   3 +
 .../modules/common/widgets/StyledSpinBox.qml  |   9 +
 .../ii/modules/settings/HyprlandConfig.qml    | 320 ++++++++++++++++++
 .../quickshell/ii/services/KraneSettings.qml  |  22 ++
 4 files changed, 354 insertions(+)

diff --git a/dots/.config/quickshell/ii/modules/common/widgets/ConfigSpinBox.qml b/dots/.config/quickshell/ii/modules/common/widgets/ConfigSpinBox.qml
index de70529f..56439b21 100644
--- a/dots/.config/quickshell/ii/modules/common/widgets/ConfigSpinBox.qml
+++ b/dots/.config/quickshell/ii/modules/common/widgets/ConfigSpinBox.qml
@@ -11,6 +11,8 @@ RowLayout {
     property alias stepSize: spinBoxWidget.stepSize
     property alias from: spinBoxWidget.from
     property alias to: spinBoxWidget.to
+    // Emitted on user edits only, not on programmatic value changes.
+    signal valueModified()
     spacing: 10
     Layout.leftMargin: 8
     Layout.rightMargin: 8
@@ -34,5 +36,6 @@ RowLayout {
         id: spinBoxWidget
         Layout.fillWidth: false
         value: root.value
+        onValueModified: root.valueModified()
     }
 }
diff --git a/dots/.config/quickshell/ii/modules/common/widgets/StyledSpinBox.qml b/dots/.config/quickshell/ii/modules/common/widgets/StyledSpinBox.qml
index f516aefc..0ae56fa0 100644
--- a/dots/.config/quickshell/ii/modules/common/widgets/StyledSpinBox.qml
+++ b/dots/.config/quickshell/ii/modules/common/widgets/StyledSpinBox.qml
@@ -34,9 +34,18 @@ SpinBox {
             font.variableAxes: Appearance.font.variableAxes.numbers
             font.pixelSize: Appearance.font.pixelSize.small
             validator: root.validator
+            // editingFinished also fires on plain focus-out; compare with the value at focus-in to detect a real edit.
+            property real valueAtFocus: root.value
+            onActiveFocusChanged: {
+                if (activeFocus) valueAtFocus = root.value
+            }
             onTextChanged: {
                 root.value = parseFloat(text);
             }
+            // contentItem is not a TextInput, so SpinBox never emits valueModified() for typed input; emit it here, only if the value changed since focus-in.
+            onEditingFinished: {
+                if (root.value !== valueAtFocus) root.valueModified()
+            }
         }
     }
 
diff --git a/dots/.config/quickshell/ii/modules/settings/HyprlandConfig.qml b/dots/.config/quickshell/ii/modules/settings/HyprlandConfig.qml
index 2b42aef8..5d5b6083 100644
--- a/dots/.config/quickshell/ii/modules/settings/HyprlandConfig.qml
+++ b/dots/.config/quickshell/ii/modules/settings/HyprlandConfig.qml
@@ -38,6 +38,15 @@ ContentPage {
 
     readonly property var borderColorRoles: ["primary", "secondary", "tertiary", "primaryContainer", "secondaryContainer", "tertiaryContainer", "layer0Border"]
 
+    // A field of the selected output that Nix sets in krane.hypr.monitors.
+    function monitorLocked(field) {
+        return KraneSettings.isMonitorFieldLocked(monitorConfig.monitors[monitorCanvas.selectedIndex]?.name ?? "", field)
+    }
+
+    readonly property bool revertPending: KraneSettings.state.revertPending === true
+
+    MonitorConfigOption { id: monitorConfig }
+
     ColumnLayout {
         id: mainLayout
         Layout.fillWidth: true
@@ -66,6 +75,317 @@ ContentPage {
             }
         }
 
+        // Displays
+        ContentSection {
+            icon: "monitor"
+            shape: MaterialShape.Shape.ClamShell
+            title: Translation.tr("Displays")
+            visible: monitorConfig.monitors.length > 0
+
+            // Shown while the revert timer runs: after a try, or when boot-check found unconfirmed display settings.
+            NoticeBox {
+                id: keepBanner
+                Layout.fillWidth: true
+                visible: KraneSettings.state.revertPending === true
+                property int countdown: 15
+                onVisibleChanged: if (visible) countdown = 15
+                Timer {
+                    interval: 1000; repeat: true; running: keepBanner.visible
+                    onTriggered: keepBanner.countdown = Math.max(0, keepBanner.countdown - 1)
+                }
+                text: Translation.tr("Keep these display settings? Reverting in %1 s").arg(keepBanner.countdown)
+                Item { Layout.fillWidth: true }
+                RippleButtonWithIcon {
+                    Layout.fillWidth: false
+                    buttonRadius: Appearance.rounding.small
+                    materialIcon: "check"
+                    mainText: Translation.tr("Keep")
+                    onClicked: KraneSettings.confirm()
+                }
+                RippleButtonWithIcon {
+                    Layout.fillWidth: false
+                    buttonRadius: Appearance.rounding.small
+                    materialIcon: "undo"
+                    mainText: Translation.tr("Revert")
+                    onClicked: KraneSettings.revert()
+                }
+            }
+
+            MonitorCanvas {
+                id: monitorCanvas
+                Layout.fillWidth: true
+                monitorConfig: monitorConfig
+                enabled: !page.revertPending
+                isPositionLocked: name => KraneSettings.isMonitorFieldLocked(name, "position")
+            }
+
+            ContentSubsection {
+                Layout.topMargin: 10
+                enabled: !page.revertPending
+                title: (monitorConfig.monitors[monitorCanvas.selectedIndex]?.name ?? "")
+                    + " · "
+                    + (monitorConfig.monitors[monitorCanvas.selectedIndex]?.description ?? "")
+
+                GroupedList {
+                    ConfigSwitch {
+                        buttonIcon: "tv_off"
+                        text: Translation.tr("Enabled") + (page.monitorLocked("disabled") ? ` · ${KraneSettings.nixReason}` : "")
+                        enabled: monitorConfig.monitors.length > 1 && !page.monitorLocked("disabled")
+                        checked: !(monitorConfig.monitors[monitorCanvas.selectedIndex]?.disabled ?? false)
+                        onCheckedChanged: {
+                            if (checked === !(monitorConfig.monitors[monitorCanvas.selectedIndex]?.disabled ?? false)) return
+                            monitorConfig.updateMonitor(monitorCanvas.selectedIndex, { disabled: !checked })
+                            monitorConfig.save(monitorCanvas.selectedIndex)
+                        }
+                    }
+
+                    ConfigComboBox {
+                        Layout.fillWidth: true
+                        buttonIcon: "aspect_ratio"
+                        text: Translation.tr("Resolution & Refresh Rate") + (page.monitorLocked("mode") ? ` · ${KraneSettings.nixReason}` : "")
+                        enabled: !page.monitorLocked("mode")
+                        textRole: "display"
+                        model: (monitorConfig.monitors[monitorCanvas.selectedIndex]?.availableModes ?? [])
+                            .map(mode => ({ display: mode, value: mode }))
+                        currentValue: monitorConfig.monitors[monitorCanvas.selectedIndex]?.currentMode ?? ""
+                        onSelected: newValue => {
+                            const mode = newValue
+                            const parts = mode.match(/(\d+)x(\d+)@([\d.]+)Hz/)
+                            monitorConfig.updateMonitor(monitorCanvas.selectedIndex, {
+                                currentMode: mode,
+                                width: parseInt(parts[1]),
+                                height: parseInt(parts[2]),
+                                refreshRate: parseFloat(parts[3])
+                            })
+                            monitorConfig.save(monitorCanvas.selectedIndex)
+                        }
+                    }
+
+                    ConfigSelectionArray {
+                        text: Translation.tr("Orientation") + (page.monitorLocked("transform") ? ` · ${KraneSettings.nixReason}` : "")
+                        icon: "mobile_rotate"
+                        enabled: !page.monitorLocked("transform")
+                        currentValue: monitorConfig.monitors[monitorCanvas.selectedIndex]?.transform ?? 0
+                        onSelected: newValue => {
+                            monitorConfig.updateMonitor(monitorCanvas.selectedIndex, { transform: newValue })
+                            monitorConfig.save(monitorCanvas.selectedIndex)
+                        }
+                        options: [
+                            { displayName: Translation.tr("Normal"), icon: "screen_rotation_alt", value: 0 },
+                            { displayName: "90°",                    icon: "rotate_90_degrees_cw",  value: 1 },
+                            { displayName: "180°",                   icon: "screen_rotation",       value: 2 },
+                            { displayName: "270°",                   icon: "rotate_90_degrees_ccw", value: 3 },
+                        ]
+                    }
+
+                    ConfigSpinBox {
+                        icon: "zoom_in"
+                        text: Translation.tr("Scale") + (page.monitorLocked("scale") ? ` · ${KraneSettings.nixReason}` : "")
+                        enabled: !page.monitorLocked("scale")
+                        value: Math.round((monitorConfig.monitors[monitorCanvas.selectedIndex]?.scale ?? 1.0) * 100)
+                        from: 25; to: 400; stepSize: 25
+                        onValueModified: {
+                            const newVal = value / 100.0
+                            if (newVal === (monitorConfig.monitors[monitorCanvas.selectedIndex]?.scale ?? 1.0)) return
+                            monitorConfig.updateMonitor(monitorCanvas.selectedIndex, { scale: newVal })
+                            monitorConfig.save(monitorCanvas.selectedIndex)
+                        }
+                    }
+
+                    ConfigSpinBox {
+                        icon: "swap_horiz"
+                        text: Translation.tr("Position X") + (page.monitorLocked("position") ? ` · ${KraneSettings.nixReason}` : "")
+                        enabled: !page.monitorLocked("position")
+                        value: monitorConfig.monitors[monitorCanvas.selectedIndex]?.x ?? 0
+                        from: -16384; to: 16384; stepSize: 1
+                        onValueModified: {
+                            if (value === (monitorConfig.monitors[monitorCanvas.selectedIndex]?.x ?? 0)) return
+                            monitorConfig.updateMonitor(monitorCanvas.selectedIndex, { x: value })
+                            monitorConfig.save(monitorCanvas.selectedIndex)
+                        }
+                    }
+
+                    ConfigSpinBox {
+                        icon: "swap_vert"
+                        text: Translation.tr("Position Y") + (page.monitorLocked("position") ? ` · ${KraneSettings.nixReason}` : "")
+                        enabled: !page.monitorLocked("position")
+                        value: monitorConfig.monitors[monitorCanvas.selectedIndex]?.y ?? 0
+                        from: -16384; to: 16384; stepSize: 1
+                        onValueModified: {
+                            if (value === (monitorConfig.monitors[monitorCanvas.selectedIndex]?.y ?? 0)) return
+                            monitorConfig.updateMonitor(monitorCanvas.selectedIndex, { y: value })
+                            monitorConfig.save(monitorCanvas.selectedIndex)
+                        }
+                    }
+                }
+            }
+
+            ContentSubsection {
+                Layout.topMargin: 10
+                enabled: !page.revertPending
+                title: Translation.tr("HDR & Color Management")
+                visible: monitorConfig.monitors[monitorCanvas.selectedIndex]?.hdrSupported === true
+
+                GroupedList {
+                    ConfigSelectionArray {
+                        text: Translation.tr("Bit depth") + (page.monitorLocked("bitdepth") ? ` · ${KraneSettings.nixReason}` : "")
+                        icon: "gradient"
+                        enabled: !page.monitorLocked("bitdepth")
+                        currentValue: monitorConfig.monitors[monitorCanvas.selectedIndex]?.bitdepth
+                            ?? (monitorConfig.monitors[monitorCanvas.selectedIndex]?.maxBpc ?? 8)
+                        onSelected: newValue => {
+                            monitorConfig.updateMonitor(monitorCanvas.selectedIndex, { bitdepth: newValue })
+                            monitorConfig.save(monitorCanvas.selectedIndex)
+                        }
+                        options: (() => {
+                            const maxBpc = monitorConfig.monitors[monitorCanvas.selectedIndex]?.maxBpc ?? 8
+                            return [
+                                { displayName: "8-bit",  icon: "filter_8", value: 8  },
+                                { displayName: "10-bit", icon: "palette",   value: 10 },
+                                { displayName: "12-bit", icon: "hdr_on",   value: 12 },
+                            ].filter(o => o.value <= maxBpc)
+                        })()
+                    }
+
+                    ConfigComboBox {
+                        Layout.fillWidth: true
+                        buttonIcon: "palette"
+                        text: Translation.tr("Color management") + (page.monitorLocked("cm") ? ` · ${KraneSettings.nixReason}` : "")
+                        enabled: monitorConfig.monitors[monitorCanvas.selectedIndex]?.hdrSupported !== false && !page.monitorLocked("cm")
+                        model: [
+                            { displayName: Translation.tr("Auto"),       icon: "auto_awesome",  value: "auto"    },
+                            { displayName: "sRGB",                       icon: "light_mode",    value: "srgb"    },
+                            { displayName: Translation.tr("Wide (P3)"),  icon: "wb_iridescent", value: "wide"    },
+                            { displayName: "HDR",                        icon: "hdr_on",        value: "hdr"     },
+                            { displayName: Translation.tr("HDR (EDID)"), icon: "hdr_auto",      value: "hdredid" },
+                        ]
+                        currentValue: monitorConfig.monitors[monitorCanvas.selectedIndex]?.cm ?? "auto"
+                        onSelected: newValue => {
+                            const hdr = newValue === "hdr" || newValue === "hdredid"
+                            monitorConfig.updateMonitor(monitorCanvas.selectedIndex, hdr ? { cm: newValue, bitdepth: 10 } : { cm: newValue })
+                            monitorConfig.save(monitorCanvas.selectedIndex)
+                        }
+                    }
+
+                    RowLayout {
+                        Layout.fillWidth: true
+                        spacing: 8
+
+                        ConfigSpinBox {
+                            Layout.fillWidth: true
+                            enabled: monitorConfig.monitors[monitorCanvas.selectedIndex]?.cm === "hdr" || monitorConfig.monitors[monitorCanvas.selectedIndex]?.cm === "hdredid"
+                            icon: "brightness_6"
+                            text: Translation.tr("SDR brightness")
+                            value: Math.round((monitorConfig.monitors[monitorCanvas.selectedIndex]?.sdrBrightness ?? 1.0) * 100)
+                            from: 50; to: 300; stepSize: 5
+                            onValueModified: {
+                                const newVal = value / 100.0
+                                if (newVal === (monitorConfig.monitors[monitorCanvas.selectedIndex]?.sdrBrightness ?? 1.0)) return
+                                monitorConfig.updateMonitor(monitorCanvas.selectedIndex, { sdrBrightness: newVal })
+                                monitorConfig.save(monitorCanvas.selectedIndex)
+                            }
+                        }
+
+                        ConfigSpinBox {
+                            Layout.fillWidth: true
+                            enabled: monitorConfig.monitors[monitorCanvas.selectedIndex]?.cm === "hdr" || monitorConfig.monitors[monitorCanvas.selectedIndex]?.cm === "hdredid"
+                            icon: "contrast"
+                            text: Translation.tr("SDR saturation")
+                            value: Math.round((monitorConfig.monitors[monitorCanvas.selectedIndex]?.sdrSaturation ?? 1.0) * 100)
+                            from: 0; to: 200; stepSize: 5
+                            onValueModified: {
+                                const newVal = value / 100.0
+                                if (newVal === (monitorConfig.monitors[monitorCanvas.selectedIndex]?.sdrSaturation ?? 1.0)) return
+                                monitorConfig.updateMonitor(monitorCanvas.selectedIndex, { sdrSaturation: newVal })
+                                monitorConfig.save(monitorCanvas.selectedIndex)
+                            }
+                        }
+                    }
+
+                    RowLayout {
+                        Layout.fillWidth: true
+                        spacing: 8
+
+                        ConfigSpinBox {
+                            Layout.fillWidth: true
+                            icon: "wb_twilight"
+                            text: Translation.tr("SDR min (nits)")
+                            value: Math.round(monitorConfig.monitors[monitorCanvas.selectedIndex]?.sdrMinLuminance ?? 0)
+                            from: 0; to: 10; stepSize: 1
+                            enabled: monitorConfig.monitors[monitorCanvas.selectedIndex]?.cm === "hdr" || monitorConfig.monitors[monitorCanvas.selectedIndex]?.cm === "hdredid"
+                            onValueModified: {
+                                const newVal = value
+                                if (newVal === (monitorConfig.monitors[monitorCanvas.selectedIndex]?.sdrMinLuminance ?? 0)) return
+                                monitorConfig.updateMonitor(monitorCanvas.selectedIndex, { sdrMinLuminance: newVal })
+                                monitorConfig.save(monitorCanvas.selectedIndex)
+                            }
+                        }
+
+                        ConfigSpinBox {
+                            Layout.fillWidth: true
+                            icon: "wb_sunny"
+                            text: Translation.tr("SDR max (nits)")
+                            value: Math.round(monitorConfig.monitors[monitorCanvas.selectedIndex]?.sdrMaxLuminance ?? 250)
+                            from: 0; to: 10000; stepSize: 10
+                            enabled: monitorConfig.monitors[monitorCanvas.selectedIndex]?.cm === "hdr" || monitorConfig.monitors[monitorCanvas.selectedIndex]?.cm === "hdredid"
+                            onValueModified: {
+                                const newVal = value
+                                if (newVal === (monitorConfig.monitors[monitorCanvas.selectedIndex]?.sdrMaxLuminance ?? 250)) return
+                                monitorConfig.updateMonitor(monitorCanvas.selectedIndex, { sdrMaxLuminance: newVal })
+                                monitorConfig.save(monitorCanvas.selectedIndex)
+                            }
+                        }
+                    }
+
+                    RowLayout {
+                        Layout.fillWidth: true
+                        spacing: 8
+
+                        ConfigSpinBox {
+                            Layout.fillWidth: true
+                            icon: "nightlight"
+                            text: Translation.tr("HDR min (nits)")
+                            value: monitorConfig.monitors[monitorCanvas.selectedIndex]?.minLuminance ?? 0
+                            from: -1; to: 10; stepSize: 1
+                            enabled: monitorConfig.monitors[monitorCanvas.selectedIndex]?.cm === "hdr" || monitorConfig.monitors[monitorCanvas.selectedIndex]?.cm === "hdredid"
+                            onValueModified: {
+                                if (value === (monitorConfig.monitors[monitorCanvas.selectedIndex]?.minLuminance ?? 0)) return
+                                monitorConfig.updateMonitor(monitorCanvas.selectedIndex, { minLuminance: value })
+                                monitorConfig.save(monitorCanvas.selectedIndex)
+                            }
+                        }
+
+                        ConfigSpinBox {
+                            Layout.fillWidth: true
+                            icon: "hdr_strong"
+                            text: Translation.tr("HDR peak (nits)")
+                            value: monitorConfig.monitors[monitorCanvas.selectedIndex]?.maxLuminance ?? 1000
+                            from: -1; to: 10000; stepSize: 50
+                            enabled: monitorConfig.monitors[monitorCanvas.selectedIndex]?.cm === "hdr" || monitorConfig.monitors[monitorCanvas.selectedIndex]?.cm === "hdredid"
+                            onValueModified: {
+                                if (value === (monitorConfig.monitors[monitorCanvas.selectedIndex]?.maxLuminance ?? 1000)) return
+                                monitorConfig.updateMonitor(monitorCanvas.selectedIndex, { maxLuminance: value })
+                                monitorConfig.save(monitorCanvas.selectedIndex)
+                            }
+                        }
+                    }
+
+                    ConfigSpinBox {
+                        icon: "hdr_weak"
+                        text: Translation.tr("HDR max average luminance (nits)")
+                        value: monitorConfig.monitors[monitorCanvas.selectedIndex]?.maxAvgLuminance ?? 250
+                        from: -1; to: 10000; stepSize: 10
+                        enabled: monitorConfig.monitors[monitorCanvas.selectedIndex]?.cm === "hdr" || monitorConfig.monitors[monitorCanvas.selectedIndex]?.cm === "hdredid"
+                        onValueModified: {
+                            if (value === (monitorConfig.monitors[monitorCanvas.selectedIndex]?.maxAvgLuminance ?? 250)) return
+                            monitorConfig.updateMonitor(monitorCanvas.selectedIndex, { maxAvgLuminance: value })
+                            monitorConfig.save(monitorCanvas.selectedIndex)
+                        }
+                    }
+                }
+            }
+        }
+
         // Layout
         ContentSection {
             icon: "auto_awesome_mosaic"
diff --git a/dots/.config/quickshell/ii/services/KraneSettings.qml b/dots/.config/quickshell/ii/services/KraneSettings.qml
index 74882cbe..9f648251 100644
--- a/dots/.config/quickshell/ii/services/KraneSettings.qml
+++ b/dots/.config/quickshell/ii/services/KraneSettings.qml
@@ -46,6 +46,21 @@ Singleton {
         root._enqueue(["apply"]);
     }
 
+    function tryMonitor(output, fields) {
+        const args = ["try", "monitor", output];
+        for (const k in fields)
+            args.push(k, String(fields[k]));
+        root._enqueue(args);
+    }
+
+    function confirm() {
+        root._enqueue(["confirm"]);
+    }
+
+    function revert() {
+        root._enqueue([root.state.pending?.kind === "boot" ? "revert-unconfirmed" : "apply"]);
+    }
+
     property bool _getPending: false
 
     function refresh() {
@@ -159,6 +174,13 @@ Singleton {
         }
     }
 
+    Timer {
+        interval: 1000
+        repeat: true
+        running: root.state.revertPending === true
+        onTriggered: root.refresh()
+    }
+
     Component.onCompleted: {
         root.refresh();
         availabilityCheck.start();
