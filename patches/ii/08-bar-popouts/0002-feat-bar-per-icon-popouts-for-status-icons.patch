@@ -0,0 +1,33 @@
+import qs.services
+import qs.modules.common
+import qs.modules.common.widgets
+import QtQuick
+import QtQuick.Layouts
+
+RowLayout {
+    id: root
+    property string title
+    property bool showSwitch: false
+    property bool switchChecked: false
+    signal switched(bool checked)
+    signal detailsClicked()
+
+    Layout.fillWidth: true
+    spacing: 8
+
+    StyledText {
+        Layout.fillWidth: true
+        text: root.title
+        font.pixelSize: Appearance.font.pixelSize.larger
+        color: Appearance.colors.colOnSurfaceVariant
+    }
+    StyledSwitch {
+        visible: root.showSwitch
+        checked: root.switchChecked
+        onClicked: root.switched(!root.switchChecked)
+    }
+    DialogButton {
+        buttonText: Translation.tr("Details")
+        onClicked: root.detailsClicked()
+    }
+}
diff --git a/dots/.config/quickshell/ii/modules/ii/bar/BarPopoutIcon.qml b/dots/.config/quickshell/ii/modules/ii/bar/BarPopoutIcon.qml
new file mode 100644
index 00000000..8676d3f6
--- /dev/null
+++ b/dots/.config/quickshell/ii/modules/ii/bar/BarPopoutIcon.qml
@@ -0,0 +1,33 @@
+import qs
+import qs.modules.common
+import qs.modules.common.widgets
+import QtQuick
+import Quickshell
+
+MaterialSymbol {
+    id: root
+    required property string popout
+    iconSize: Appearance.font.pixelSize.larger
+
+    MouseArea {
+        anchors.fill: parent
+        anchors.margins: -4
+        enabled: Config.options.bar.iconPopouts
+        acceptedButtons: Qt.LeftButton
+        cursorShape: Qt.PointingHandCursor
+        preventStealing: true
+        onPressed: mouse => mouse.accepted = true
+        onClicked: {
+            const win = root.QsWindow.window;
+            if (GlobalStates.barPopout === root.popout && GlobalStates.barPopoutScreen === win.screen.name) {
+                GlobalStates.barPopout = "";
+                return;
+            }
+            const p = root.mapToItem(null, 0, 0);
+            GlobalStates.barPopoutScreen = win.screen.name;
+            GlobalStates.barPopoutAnchor = { x: p.x, y: p.y, width: root.width, height: root.height };
+            GlobalStates.sidebarRightOpen = false;
+            GlobalStates.barPopout = root.popout;
+        }
+    }
+}
