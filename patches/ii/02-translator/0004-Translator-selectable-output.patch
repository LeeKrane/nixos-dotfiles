From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: krane <chris@krane.dev>
Date: Tue, 29 Sep 2026 16:57:53 +0200
Subject: [PATCH] Translator: selectable output

Problem: the output box rendered the translation as plain Text, so it could not be selected to copy part of it.
Port: new. The output is a read-only StyledTextArea with the input box's settings, and it follows the caret while it has focus so a selection drag scrolls the box. Its placeholder uses the text area's placeholder colour (m3outline, as the input does) instead of colSubtext. displayedText, copy and search are unchanged.
Drop when: the pinned modules/ii/sidebarLeft/translator/TextCanvas.qml output area is selectable.
---
 .../ii/sidebarLeft/translator/TextCanvas.qml  | 19 ++++++++++++-------
 1 file changed, 12 insertions(+), 7 deletions(-)

diff --git a/dots/.config/quickshell/ii/modules/ii/sidebarLeft/translator/TextCanvas.qml b/dots/.config/quickshell/ii/modules/ii/sidebarLeft/translator/TextCanvas.qml
index 234033c5..6964984c 100644
--- a/dots/.config/quickshell/ii/modules/ii/sidebarLeft/translator/TextCanvas.qml
+++ b/dots/.config/quickshell/ii/modules/ii/sidebarLeft/translator/TextCanvas.qml
@@ -13,8 +13,7 @@ Rectangle {
     property string text: ""
     property color containerColor: Appearance.colors.colLayer2
     property var inputTextArea: isInput ? inputLoader.item : undefined
-    readonly property string displayedText: isInput ? inputLoader.item?.text ?? "" :
-        root.text.length > 0 ? outputLoader.item?.text ?? "" : ""
+    readonly property string displayedText: isInput ? inputLoader.item?.text ?? "" : root.text
     default property alias actionButtons: actions.data
     Layout.fillWidth: true
     Layout.fillHeight: true
@@ -87,13 +86,19 @@ Rectangle {
                     visible: !root.isInput
                     Layout.fillWidth: true
                     Layout.fillHeight: true
-                    sourceComponent: StyledText { // Output area
+                    sourceComponent: StyledTextArea { // Output area
                         id: outputTextArea
-                        padding: 15
-                        wrapMode: Text.Wrap
+                        readOnly: true
+                        selectByMouse: true
+                        placeholderText: root.placeholderText
+                        text: root.text
+                        wrapMode: TextEdit.Wrap
+                        textFormat: TextEdit.PlainText
                         font.pixelSize: Appearance.font.pixelSize.small
-                        color: root.text.length > 0 ? Appearance.colors.colOnLayer1 : Appearance.colors.colSubtext
-                        text: root.text.length > 0 ? root.text : root.placeholderText
+                        color: Appearance.colors.colOnLayer1
+                        padding: 15
+                        background: null
+                        onCursorRectangleChanged: if (activeFocus) root.ensureVisible(cursorRectangle, padding)
                     }
                 }
             }
