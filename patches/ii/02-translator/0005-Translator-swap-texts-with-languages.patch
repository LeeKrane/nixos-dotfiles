From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: krane <chris@krane.dev>
Date: Wed, 30 Sep 2026 00:00:04 +0200
Subject: [PATCH] Translator: swap texts with languages

Problem: the swap button swapped only the languages, so the input kept the old source text and was re-translated in the wrong direction; pressing it before a translation finished swapped against stale output.
Port: new. Swap also moves the output into the input and the input into the output; while a translation is pending the swap waits for it (a second press cancels), and the swap button shows the queued state.
Drop when: the pinned modules/ii/sidebarLeft/Translator.qml swap exchanges the texts.
---
 .../ii/modules/ii/sidebarLeft/Translator.qml  | 40 ++++++++++++++++++-
 1 file changed, 38 insertions(+), 2 deletions(-)

diff --git a/dots/.config/quickshell/ii/modules/ii/sidebarLeft/Translator.qml b/dots/.config/quickshell/ii/modules/ii/sidebarLeft/Translator.qml
index bde79536..2f68669c 100644
--- a/dots/.config/quickshell/ii/modules/ii/sidebarLeft/Translator.qml
+++ b/dots/.config/quickshell/ii/modules/ii/sidebarLeft/Translator.qml
@@ -33,6 +33,7 @@ Item {
     // States
     property bool showLanguageSelector: false
     property bool languageSelectorTarget: false // true for target language, false for source language
+    property bool swapPending: false // Swap requested while a translation was still running
 
     function showLanguageSelectorDialog(isTargetLang: bool) {
         root.languageSelectorTarget = isTargetLang;
@@ -40,6 +41,15 @@ Item {
     }
 
     function swapLanguages() {
+        if (translateTimer.running || translateProc.running) {
+            root.swapPending = !root.swapPending; // Wait for the translation, or cancel a queued swap
+            return;
+        }
+        root.doSwap();
+    }
+
+    function doSwap() {
+        root.swapPending = false;
         let temp = root.targetLanguage;
         root.targetLanguage = root.sourceLanguage;
         root.sourceLanguage = temp;
@@ -48,7 +58,15 @@ Item {
         Config.options.language.translator.targetLanguage = root.targetLanguage;
         Config.options.language.translator.sourceLanguage = root.sourceLanguage;
 
-        translateTimer.restart(); // Restart translation after swap
+        const input = root.inputField.text;
+        const output = root.translatedText.trim();
+        if (input.trim().length > 0 && output.length > 0) {
+            root.inputField.text = output; // Restarts translateTimer via onInputTextChanged
+            root.translatedText = input.trim();
+            translateTimer.stop();
+        } else {
+            translateTimer.restart(); // Restart translation after swap
+        }
     }
 
     onFocusChanged: (focus) => {
@@ -64,11 +82,17 @@ Item {
         onTriggered: () => {
             if (root.inputField.text.trim().length > 0) {
                 // console.log("Translating with command:", translateProc.command);
+                translateProc.stale = translateProc.running;
                 translateProc.running = false;
                 translateProc.buffer = ""; // Clear the buffer
                 translateProc.running = true; // Restart the process
             } else {
+                if (translateProc.running) {
+                    translateProc.stale = true;
+                    translateProc.running = false;
+                }
                 root.translatedText = "";
+                if (root.swapPending && !translateProc.running) root.doSwap();
             }
         }
     }
@@ -80,14 +104,25 @@ Item {
             + ` -target '${StringUtils.shellSingleQuoteEscape(root.targetLanguage)}'`
             + ` '${StringUtils.shellSingleQuoteEscape((root.inputField?.text ?? "").trim())}'`]
         property string buffer: ""
+        property bool stale: false
         stdout: SplitParser {
             onRead: data => {
                 translateProc.buffer += data + "\n";
             }
         }
         onExited: (exitCode, exitStatus) => {
+            if (translateProc.stale) {
+                translateProc.stale = false;
+                // The kill that made this run stale may have been the empty-input
+                // branch abandoning it rather than a restart. Resolve any pending
+                // swap here too, but only once nothing newer is in flight.
+                if (root.swapPending && !translateProc.running && !translateTimer.running
+                    && root.inputField.text.trim().length === 0) root.doSwap();
+                return;
+            }
             // With -brief mode, we get output with no metadata
             root.translatedText = translateProc.buffer.trim();
+            if (root.swapPending && !translateProc.running && !translateTimer.running) root.doSwap();
         }
     }
 
@@ -179,6 +214,7 @@ Item {
             GroupButton { // Swap languages button
                 id: swapButton
                 Layout.preferredWidth: height
+                toggled: root.swapPending
                 colBackground: Appearance.colors.colTertiaryContainer
                 colBackgroundHover: Appearance.colors.colTertiaryContainerHover
                 buttonRadius: Appearance.rounding.full
@@ -187,7 +223,7 @@ Item {
                     horizontalAlignment: Text.AlignHCenter
                     iconSize: Appearance.font.pixelSize.larger
                     text: "autorenew"
-                    color: Appearance.colors.colOnLayer1
+                    color: swapButton.toggled ? Appearance.colors.colOnPrimary : Appearance.colors.colOnLayer1
                 }
                 onClicked: {
                     root.swapLanguages();
